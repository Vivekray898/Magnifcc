---
// src/layouts/Layout.astro

import { client } from '../lib/sanity';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  keywords?: string;
  fetchFromSanity?: boolean;
}

const { 
  title = "Magnific Healthcare Solutions", 
  description = "Your Trustful Solutions Partner in Healthcare Infrastructure",
  image = "/assets/img/logo.png",
  keywords = "Magnific Healthcare Solutions, healthcare infrastructure consultancy, hospital planning, medical equipment planning, NABH accreditation, public health consultancy, healthcare IT solutions, hospital management consultancy",
  fetchFromSanity = true 
} = Astro.props;

// Default SEO data based on Magnific Healthcare Solutions
let seoData = {
  title: "Magnific Healthcare Solutions – Your Trustful Solutions Partner in Healthcare Infrastructure",
  description: "Magnific Healthcare Solutions is a leading healthcare infrastructure consultancy helping medical practitioners, hospital owners, and healthcare administrators plan, design, and deliver successful healthcare projects from ideation to final commissioning.",
  keywords: "Magnific Healthcare Solutions, healthcare infrastructure consultancy, hospital planning, design, commissioning, market feasibility studies, DPR, healthcare architecture, medical equipment planning, NABH accreditation, NABL accreditation, public health project management, healthcare event management, HIS, LMIS",
  ogTitle: "Magnific Healthcare Solutions – Healthcare Infrastructure Consultancy",
  ogDescription: "Magnific Healthcare Solutions is a leading healthcare infrastructure consultancy helping medical practitioners, hospital owners, and healthcare administrators plan, design, and deliver successful healthcare projects from ideation to final commissioning.",
  ogImage: "https://magnific-healthcare.com/assets/img/og-image.png",
  ogUrl: "https://magnific-healthcare.com/",
  twitterCard: "summary_large_image",
  twitterTitle: "Magnific Healthcare Solutions – Healthcare Infrastructure Consultancy",
  twitterDescription: "Magnific Healthcare Solutions is a leading healthcare infrastructure consultancy helping medical practitioners, hospital owners, and healthcare administrators plan, design, and deliver successful healthcare projects from ideation to final commissioning.",
  twitterImage: "https://magnific-healthcare.com/assets/img/og-image.png",
  favicon: "/assets/img/favicon.png",
  siteName: "Magnific Healthcare Solutions",
  address: "Sarada Apartment, Opp. College Para Sishu Uddyan, Ashutosh Mukherjee Road, College Para, Siliguri – 734001",
  contactNumber: "013 354 213 - 92132",
  email: "info@magnific-healthcare.com",
};

// Fetch settings from Sanity
if (fetchFromSanity) {
  try {
    const query = `*[_type == "siteSettings"][0]{
      title,
      seo {
        title,
        description,
        keywords,
        ogTitle,
        ogDescription,
        ogImage {
          asset->{
            url
          }
        },
        ogUrl,
        twitterCard,
        twitterTitle,
        twitterDescription,
        twitterImage {
          asset->{
            url
          }
        },
        favicon {
          asset->{
            url
          }
        }
      },
      contactInfo {
        address,
        phone,
        email
      }
    }`;
    
    const result = await client.fetch(query);
    
    if (result) {
      // Update site title if available
      if (result.title) {
        seoData.siteName = result.title;
      }
      
      // Update SEO data
      if (result.seo) {
        seoData = {
          ...seoData,
          ...result.seo,
          ogImage: result.seo.ogImage?.asset?.url || seoData.ogImage,
          twitterImage: result.seo.twitterImage?.asset?.url || seoData.twitterImage,
          favicon: result.seo.favicon?.asset?.url || seoData.favicon,
        };
      }
      
      // Update contact info
      if (result.contactInfo) {
        if (result.contactInfo.address) seoData.address = result.contactInfo.address;
        if (result.contactInfo.phone) seoData.contactNumber = result.contactInfo.phone;
        if (result.contactInfo.email) seoData.email = result.contactInfo.email;
      }
    }
  } catch (error) {
    console.error('Error fetching site settings:', error);
  }
}

// Use page title if provided, otherwise use SEO title
const pageTitle = title || seoData.title;
const pageDescription = description || seoData.description;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <!-- Primary Meta Tags -->
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta name="keywords" content={seoData.keywords} />
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={seoData.ogUrl || Astro.url?.href || 'https://magnific-healthcare.com/'} />
  <meta property="og:title" content={seoData.ogTitle || pageTitle} />
  <meta property="og:description" content={seoData.ogDescription || pageDescription} />
  <meta property="og:image" content={seoData.ogImage} />
  
  <!-- Twitter -->
  <meta name="twitter:card" content={seoData.twitterCard} />
  <meta name="twitter:title" content={seoData.twitterTitle || seoData.ogTitle || pageTitle} />
  <meta name="twitter:description" content={seoData.twitterDescription || seoData.ogDescription || pageDescription} />
  <meta name="twitter:image" content={seoData.twitterImage || seoData.ogImage} />
  
  <!-- Favicon -->
  <link rel="icon" href={seoData.favicon} />
  
  <!-- Icons -->
  <link rel="stylesheet" type="text/css" href="/assets/icons/flaticon/flaticon.css" />
  <link rel="stylesheet" type="text/css" href="/assets/icons/fontawesome/css/all.min.css" />
  <link type="text/css" rel="stylesheet" href="/assets/icons/themify-icons/css/themify-icons.css" />
  
  <!-- Plugins -->
  <link rel="stylesheet" href="/assets/plugins/swiper/swiper-bundle.min.css" />
  
  <!-- Styles -->
  <link rel="stylesheet" href="/assets/css/style.css" />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@100..800&family=Urbanist:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
  
  <slot name="head" />
</head>
<body class="selection:bg-primary selection:text-white">
  <!-- Preloader -->
  <div class="preloader">
    <div id="loader"></div>
  </div>
  
  <!-- Header Slot -->
  <slot name="header" />
  
  <!-- Main Content -->
  <main>
    <slot />
  </main>
  
  <!-- Footer Slot -->
  <slot name="footer" />
  
  <!-- Search Popup -->
  <div class="search-popup">
    <button class="close-search"><i class="fa-solid fa-xmark"></i></button>
    <form method="post" action="#">
      <div class="form-group relative overflow-hidden">
        <input type="search" name="search-field" value="" placeholder="Search Here" required="" class="placeholder:text-black" />
        <button type="submit"><i class="fa fa-search"></i></button>
      </div>
    </form>
  </div>
  
  <!-- Progress -->
  <div id="scroll-percentage"><span id="scroll-percentage-value"></span></div>
  
  <!-- Scripts -->
  <script is:inline src="/assets/js/jquery.min.js"></script>
  <script is:inline src="/assets/plugins/swiper/swiper-bundle.min.js"></script>
  <script is:inline src="/assets/plugins/counter/waypoints-min.js"></script>
  <script is:inline src="/assets/js/circle-progres.js"></script>
  <script is:inline src="/assets/js/dz.carousel.js"></script>
  <script is:inline src="/assets/js/custom.js"></script>
  <script is:inline src="/assets/js/preloader.js"></script>
  <script is:inline src="/assets/js/dz.ajax.js"></script>
  
  <slot name="scripts" />
</body>
</html>