---
// src/pages/services/index.astro

import Layout from "../../layouts/Layout.astro";
import Header from "../../components/common/Header.astro";
import Footer from "../../components/common/Footer.astro";
import ServicesHero from "../../components/sections/services/ServicesHero.astro";
import ServicesList from "../../components/sections/services/ServicesList.astro";

// Disable static generation - use SSR
export const prerender = false;
---

<Layout title="Services" description="Our medical services">
  <Header fetchFromSanity={true} slot="header" />
  
  <!-- Services Hero -->
  <ServicesHero fetchFromSanity={true} />
  
  <!-- Services List -->
  <ServicesList fetchFromSanity={true} />
  
  <Footer fetchFromSanity={true} slot="footer" />
</Layout>