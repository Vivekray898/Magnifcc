---
// src/pages/services/[slug].astro

import Layout from "../../layouts/Layout.astro";
import Header from "../../components/common/Header.astro";
import Footer from "../../components/common/Footer.astro";
import ServicesDetailsHero from "../../components/sections/services-details/ServicesDetailsHero.astro";
import ServicesDetailsContent from "../../components/sections/services-details/ServicesDetailsContent.astro";
import { client } from "../../lib/sanity";

// Disable static generation - use SSR
export const prerender = false;

const { slug } = Astro.params;

// Fetch service data on every request
let serviceData = null;
let serviceExists = false;

if (slug) {
  try {
    const query = `*[_type == "servicesDetails" && slug.current == "${slug}"][0]{
      title,
      description,
      slug,
      icon,
      longDescription[] {
        ...,
        _type == "image" => {
          ...,
          asset->{ _id, url }
        }
      },
      sectionTitle,
      sectionContent[] {
        ...,
        _type == "image" => {
          ...,
          asset->{ _id, url }
        }
      },
      image {
        asset->{
          url
        }
      },
      bottomText[] {
        ...,
        _type == "image" => {
          ...,
          asset->{ _id, url }
        }
      },
      faqs[] {
        question,
        answer[] {
          ...,
          _type == "image" => {
            ...,
            asset->{ _id, url }
          }
        }
      },
      servicesList,
      socialLinks,
      prevService {
        title,
        link
      },
      nextService {
        title,
        link
      }
    }`;
    
    serviceData = await client.fetch(query);
    serviceExists = !!serviceData;
  } catch (error) {
    console.error('Error fetching service:', error);
  }
}
---

<Layout title={serviceData?.title || "Service Not Found"} description={serviceData?.description || "Service details"}>
  <Header fetchFromSanity={true} slot="header" />
  
  {serviceExists ? (
    <>
      <ServicesDetailsHero fetchFromSanity={true} />
      <ServicesDetailsContent slug={slug} fetchFromSanity={true} />
    </>
  ) : (
    <section class="py-20 text-center">
      <div class="container">
        <h2 class="text-3xl font-bold text-secondary">Service Not Found</h2>
        <p class="text-gary mt-4">The service you're looking for doesn't exist.</p>
        <a href="/services" class="btn mt-6 inline-block"><span>View All Services</span></a>
      </div>
    </section>
  )}
  
  <Footer fetchFromSanity={true} slot="footer" />
</Layout>