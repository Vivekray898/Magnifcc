---
// src/pages/blog/[slug].astro

import Layout from "../../layouts/Layout.astro";
import Header from '../../components/common/Header.astro';
import Footer from '../../components/common/Footer.astro';
import BlogHero from '../../components/sections/blog/BlogHero.astro';
import BlogDetails from '../../components/sections/blog/BlogDetails.astro';
import { client } from '../../lib/sanity';

// Disable static generation - use SSR
export const prerender = false;

const { slug } = Astro.params;

// Fetch blog data on every request
let blogData = null;
let blogExists = false;

if (slug) {
  try {
    const query = `*[_type == "blogPost" && slug.current == "${slug}"][0]{
      title,
      excerpt,
      content,
      publishDate,
      author,
      comments,
      featuredImage {
        asset->{
          url
        }
      },
      tags,
      featured,
      quote {
        text,
        author
      },
      shareExperience {
        title,
        content
      },
      galleryImages[] {
        asset->{
          url
        }
      },
      bottomSection {
        title,
        content
      },
      authorBio {
        name,
        avatar {
          asset->{
            url
          }
        },
        bio,
        socialIcon,
        socialLink
      }
    }`;
    
    blogData = await client.fetch(query);
    blogExists = !!blogData;
  } catch (error) {
    console.error('Error fetching blog post:', error);
  }
}
---

<Layout title={blogData?.title || "Blog Post Not Found"} description={blogData?.excerpt || "Blog post details"}>
  <Header fetchFromSanity={true} slot="header" />
  
  {blogExists ? (
    <>
      <BlogHero fetchFromSanity={true} />
      <BlogDetails slug={slug} fetchFromSanity={true} />
    </>
  ) : (
    <section class="py-20 text-center">
      <div class="container">
        <h2 class="text-3xl font-bold text-secondary">Blog Post Not Found</h2>
        <p class="text-gary mt-4">The blog post you're looking for doesn't exist.</p>
        <a href="/blog" class="btn mt-6 inline-block"><span>View All Blog Posts</span></a>
      </div>
    </section>
  )}
  
  <Footer fetchFromSanity={true} slot="footer" />
</Layout>