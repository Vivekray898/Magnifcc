---
// src/pages/blog/[slug].astro

import Layout from "../../layouts/Layout.astro";
import Header from '../../components/common/Header.astro';
import Footer from '../../components/common/Footer.astro';
import BlogHero from '../../components/sections/blog/BlogHero.astro';
import BlogDetails from '../../components/sections/blog/BlogDetails.astro';
import { client } from '../../lib/sanity';

export async function getStaticPaths() {
  try {
    const query = `*[_type == "blogPost"]{
      slug
    }`;
    
    const posts = await client.fetch(query);
    
    if (posts && posts.length > 0) {
      return posts.map((post: any) => ({
        params: { slug: post.slug?.current || 'post' },
      }));
    }
  } catch (error) {
    console.error('Error fetching blog slugs:', error);
  }
  
  return [];
}

// Enable ISR - revalidate these pages
export const getStaticProps = async () => {
  return {
    revalidate: 60, // Revalidate every 60 seconds
  };
};

const { slug } = Astro.params;

// Fetch blog data for the layout
let blogData = null;
if (slug) {
  try {
    const query = `*[_type == "blogPost" && slug.current == "${slug}"][0]{
      title,
      excerpt
    }`;
    blogData = await client.fetch(query);
  } catch (error) {
    console.error('Error fetching blog data:', error);
  }
}
---

<Layout title={blogData?.title || "Blog Details"} description={blogData?.excerpt || "Detailed blog post"}>
  <Header fetchFromSanity={true} slot="header" />
  
  <!-- Blog Hero -->
  <BlogHero fetchFromSanity={true} />
  
  <!-- Blog Details -->
  <BlogDetails slug={slug} fetchFromSanity={true} />
  
  <Footer fetchFromSanity={true} slot="footer" />
</Layout>