---
// src/components/sections/BrandLogos.astro
import { getBrandLogos } from '../../lib/queries';
import { urlFor } from '../../lib/sanity-image';

export interface Props {
  fetchFromSanity?: boolean;
  brands?: any[];
  class?: string;
  title?: string;
}

const { 
  fetchFromSanity = false, 
  brands: propBrands = [],
  class: className = '',
  title: propTitle = ''
} = Astro.props;

let brands = propBrands;
let title = propTitle;

if (fetchFromSanity) {
  try {
    const data = await getBrandLogos();
    console.log('Brand logos data from homePage:', data);
    
    if (data && data.brandLogosSection) {
      brands = data.brandLogosSection.brands || [];
      title = data.brandLogosSection.title || propTitle;
    }
  } catch (error) {
    console.error('Error in BrandLogos component:', error);
  }
}

console.log('Rendering brand logos:', { count: brands.length, title });

// Helper function to safely get image URL
function getImageUrl(image: any) {
  if (!image) return null;
  try {
    // Check if we have a direct URL
    if (image.asset?.url) return image.asset.url;
    // Use Sanity image builder
    return urlFor(image).url();
  } catch (error) {
    console.error('Error getting image URL:', error);
    return null;
  }
}
---

<div class={`container mx-auto px-4 xl:pb-120 lg:pb-100 md:pb-80 pb-60 ${className}`}>
  {title && (
    <div class="text-center mb-10">
      <h3 class="text-2xl font-semibold text-secondary font-sora">{title}</h3>
    </div>
  )}
  
  {brands && brands.length > 0 ? (
    <div class="swiper brand-slide">
      <div class="swiper-wrapper">
        {brands.map((brand, index) => {
          const imageUrl = brand.logo ? getImageUrl(brand.logo) : null;
          return (
            <div class="swiper-slide" key={brand._key || index}>
              {brand.url ? (
                <a href={brand.url} target="_blank" rel="noopener noreferrer" class="block">
                  {imageUrl ? (
                    <img 
                      src={imageUrl} 
                      alt={brand.name || 'Brand logo'}
                      class="max-h-20 object-contain mx-auto"
                      loading="lazy"
                    />
                  ) : (
                    <span class="text-gray-400">{brand.name || 'No image'}</span>
                  )}
                </a>
              ) : (
                imageUrl ? (
                  <img 
                    src={imageUrl} 
                    alt={brand.name || 'Brand logo'}
                    class="max-h-20 object-contain mx-auto"
                    loading="lazy"
                  />
                ) : (
                  <span class="text-gray-400">{brand.name || 'No image'}</span>
                )
              )}
            </div>
          );
        })}
      </div>
    </div>
  ) : (
    <div class="text-center py-10">
      <p class="text-gray-500">No brand logos available. Please add brand logos in the Home Page document in Sanity.</p>
    </div>
  )}
</div>

<style is:global>
  .brand-slide .swiper-slide {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 10px 20px !important;
    height: auto !important;
  }
  
  .brand-slide .swiper-slide img {
    filter: grayscale(1);
    opacity: 0.6;
    transition: all 0.3s ease;
    max-height: 80px;
    width: auto;
  }
  
  .brand-slide .swiper-slide:hover img {
    filter: grayscale(0);
    opacity: 1;
  }
  
  .brand-slide .swiper-wrapper {
    align-items: center !important;
  }
</style>