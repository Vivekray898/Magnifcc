---
// src/components/sections/CareersHero.astro

import { getJobListings } from '../../lib/queries';
const jobs = await getJobListings();
const departments = new Set(jobs.map((j: any) => j.department).filter(Boolean)).size;
---

<section class="bg-white border-b border-secondary/10 pt-120 pb-32">
  <div class="container">
    <div class="flex items-center gap-8 text-xs text-gary/50 mb-12">
      <a href="/" class="hover:text-primary transition-colors">Home</a>
      <span>/</span>
      <span class="text-secondary font-medium">Careers</span>
    </div>
    <div class="flex flex-wrap items-end justify-between gap-16">
      <div>
        <h1 class="text-2xl md:text-3xl font-bold font-sora text-secondary">Careers at Magnific Healthcare Solutions</h1>
        <p class="text-sm text-gary/60 mt-8 max-w-xl">Browse open positions and apply directly. Join a team committed to clinical excellence and compassionate care.</p>
      </div>
      <div class="flex items-center gap-20 text-sm text-gary/60">
        <span><b class="text-secondary font-sora">{jobs.length}</b> Open Roles</span>
        <span class="w-px h-4 bg-secondary/10"></span>
        <span><b class="text-secondary font-sora">{departments}</b> Departments</span>
      </div>
    </div>
  </div>
</section>