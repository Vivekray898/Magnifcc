---
// src/components/sections/AboutHero.astro

import { client } from '../../lib/sanity';

export interface Props {
  fetchFromSanity?: boolean;
  title?: string;
  subtitle?: string;
  image?: string;
}

const { 
  fetchFromSanity = true,
  title = "About Us",
  subtitle = "About Us",
  image = "assets/img/bannr-img.png",
} = Astro.props;

let data = { title, subtitle, image };
let imageUrl = image;

// Fetch from Sanity
if (fetchFromSanity) {
  try {
    const query = `*[_type == "aboutPage"][0]{
      heroSection {
        title,
        subtitle,
        image {
          asset->{
            _id,
            url
          }
        }
      }
    }`;
    
    const result = await client.fetch(query);
    
    if (result?.heroSection) {
      data = { ...data, ...result.heroSection };
      
      if (result.heroSection.image?.asset?.url) {
        imageUrl = result.heroSection.image.asset.url;
      }
    }
  } catch (error) {
    console.error('Error fetching about hero data:', error);
  }
}
---

<section class="pt-90 relative max-lg:bg-[right_center] bg-[#f4f4f4] bg-[url(../img/bannr-bg-img.png)] about-banner overflow-hidden">
  <div class="container">
    <div class="flex flex-wrap items-center -mx-4">
      <!-- Left Column -->
      <div class="lg:w-1/2 w-full px-4">
        <div class="relative max-md:text-center">
          <h2 class="xxl:text-7.7xl xl:text-6.3xl md:text-5.2xl sm:text-4.75xl text-4.6xl font-bold capitalize font-sora text-secondary">{data.title}</h2>
          <img 
            src="assets/img/shap-three-1.png" 
            alt="banner-shap" 
            class="absolute w-46 w-35 -top-15 -left-32 max-md:hidden animate-topshap"
            loading="lazy"
          >
        </div>
        <ol class="mb-16 flex items-center gap-2 max-md:justify-center max-md:mb-40">
          <li class="xxl:text-xxl md:text-xl text-sm text-secondary font-sora capitalize">
            <a href="index.html"> Home </a>
          </li>
          <li class="xxl:text-xxl md:text-xl text-sm text-gary capitalize" aria-current="page">
            - {data.subtitle}
          </li>
        </ol>
      </div>
      
      <!-- Right Column -->
      <div class="lg:w-1/2 w-full px-4">
        <div class="relative">
          <img 
            src={imageUrl} 
            alt="img" 
            class="w-[120%] xxl:max-w-[unset]"
            loading="lazy"
          >
        </div>
      </div>
    </div>
  </div>
</section>