---
// src/components/sections/Pricing.astro

import { client } from '../../lib/sanity';

export interface PricingPlan {
    id: number;
    title: string;
    price: string | number;
    currency?: string;
    period?: string;
    description: string;
    isFeatured?: boolean;
    features: string[];
    buttonText?: string;
    buttonLink?: string;
    planImage?: string;
    iconBg?: string;
    textColor?: string;
}

export interface Props {
    fetchFromSanity?: boolean;
    subtitle?: string;
    title?: string;
    plans?: PricingPlan[];
    backgroundClass?: string;
    shapeImages?: {
        shape1?: string;
        shape2?: string;
        dot1?: string;
        dot2?: string;
    };
}

const { fetchFromSanity = true } = Astro.props;

// Default values
const defaultSubtitle = "# Pricing Table";
const defaultTitle = "Flexible Options for Every Patient.";
const defaultBackgroundClass = "bg-[#F4F4FF]";
const defaultShapeImages = {
    shape1: "assets/img/shaps-7.png",
    shape2: "assets/img/shaps-8.png",
    dot1: "assets/img/dots-img.png",
    dot2: "assets/img/dots-img.png"
};
const defaultPlans = [
    {
        id: 1,
        title: "Basic Plan",
        price: "150",
        currency: "/Usd",
        period: "",
        description: "Primary Health Check-Up",
        isFeatured: false,
        features: [
            "Seasonal health check-up packages.",
            "Packages for routine check-ups",
            "Acceptance of major insurance plans",
            "Interest-free installment options",
            "Tailored health plans to suit individual"
        ],
        buttonText: "Pick This Package",
        buttonLink: "pricing-table.html",
        planImage: "assets/img/pricing-plan-shap.png",
        iconBg: "bg-white",
        textColor: "text-secondary"
    },
    {
        id: 2,
        title: "Standard",
        price: "80",
        currency: "/Usd",
        period: "",
        description: "Primary Health Check-Up",
        isFeatured: true,
        features: [
            "Seasonal health check-up packages.",
            "Packages for routine check-ups",
            "Acceptance of major insurance plans",
            "Interest-free installment options",
            "Tailored health plans to suit individual"
        ],
        buttonText: "Pick This Package",
        buttonLink: "pricing-table.html",
        planImage: "assets/img/pricing-plan-shap-1.png",
        iconBg: "bg-primary",
        textColor: "text-white"
    },
    {
        id: 3,
        title: "Premium",
        price: "550",
        currency: "/Usd",
        period: "",
        description: "Primary Health Check-Up",
        isFeatured: false,
        features: [
            "Seasonal health check-up packages.",
            "Packages for routine check-ups",
            "Acceptance of major insurance plans",
            "Interest-free installment options",
            "Tailored health plans to suit individual"
        ],
        buttonText: "Pick This Package",
        buttonLink: "pricing-table.html",
        planImage: "assets/img/pricing-plan-shap.png",
        iconBg: "bg-white",
        textColor: "text-secondary"
    }
];

let subtitle = defaultSubtitle;
let title = defaultTitle;
let backgroundClass = defaultBackgroundClass;
let shapeImages = defaultShapeImages;
let plans = defaultPlans;

// Fetch from Sanity
if (fetchFromSanity) {
    try {
        const query = `*[_type == "homePage"][0]{
            pricingSection {
                subtitle,
                title,
                plans[] {
                    name,
                    price,
                    currency,
                    features,
                    isPopular,
                    buttonText
                }
            }
        }`;
        
        const result = await client.fetch(query);
        
        if (result?.pricingSection) {
            // Update subtitle and title
            if (result.pricingSection.subtitle) {
                subtitle = result.pricingSection.subtitle;
            }
            if (result.pricingSection.title) {
                title = result.pricingSection.title;
            }
            
            // Map pricing plans
            if (result.pricingSection.plans?.length > 0) {
                plans = result.pricingSection.plans.map((plan: any, index: number) => {
                    // Determine if this plan should be featured (2nd plan is featured in original)
                    const isFeatured = plan.isPopular || index === 1;
                    
                    return {
                        id: index + 1,
                        title: plan.name || 'Plan',
                        price: plan.price || '0',
                        currency: plan.currency ? `/${plan.currency}` : '/Usd',
                        period: "",
                        description: "Primary Health Check-Up",
                        isFeatured: isFeatured,
                        features: plan.features || defaultPlans[0].features,
                        buttonText: plan.buttonText || 'Pick This Package',
                        buttonLink: "pricing-table.html",
                        planImage: isFeatured 
                            ? "assets/img/pricing-plan-shap-1.png" 
                            : "assets/img/pricing-plan-shap.png",
                        iconBg: isFeatured ? "bg-primary" : "bg-white",
                        textColor: isFeatured ? "text-white" : "text-secondary"
                    };
                });
            }
        }
    } catch (error) {
        console.error('Error fetching pricing data:', error);
        // Keep using default data
    }
}
---

<section class={`overflow-hidden relative ${backgroundClass} lg:py-120 md:py-80 py-60 bg-[url(../img/graph.png)] section-pricing`}>
    <div class="container">
        <div class="text-center lg:mx-auto lg:w-[60%] w-full pb-50">
            <span class="pb-10 block font-sora font-semibold text-primary xxl:text-xxl xl:text-xl sm:text-lg text-base">{subtitle}</span>
            <h2 class="xl:text-5xl md:text-4xl sm:text-3xl text-2.5xl font-semibold text-secondary font-sora leading-[1.2]">{title}</h2>
        </div>
        <div class="grid grid-cols-12 gap-25">
            {plans.map((plan) => (
                <div class="lg:col-span-4 col-span-12" key={plan.id}>
                    <div class={`${plan.isFeatured ? 'pricing-plan two bg-primary' : 'bg-white'} p-30 relative z-[1] hover:shadow-[0px_0px_30px_0px_rgba(0,0,0,0.1)] duration-500`}>
                        <img src={plan.planImage} class="absolute right-30 top-30" alt={plan.title} loading="lazy">
                        <h5 class={`font-bold pb-5 ${plan.isFeatured ? 'text-white' : 'text-secondary'} font-sora text-xl`}>{plan.title}</h5>
                        <h3 class={`text-5.2xl font-bold pb-10 ${plan.isFeatured ? 'text-white' : 'text-secondary'} font-sora`}>
                            {plan.price}
                            <span class={`pl-6 text-base ${plan.isFeatured ? 'text-white' : ''}`}>{plan.currency}</span>
                        </h3>
                        <span class={plan.isFeatured ? 'text-white' : ''}>{plan.description}</span>
                        <ul class={`list-style border-t border-[#D8D8D8] pt-26 mt-21 pb-30 relative ${!plan.isFeatured ? 'before:absolute before:w-1/2 before:bg-primary before:-top-px before:h-px' : ''}`}>
                            {plan.features.map((feature, idx) => (
                                <li key={idx} class={`font-normal pb-21 font-sora pl-20 relative ${plan.isFeatured ? 'text-white' : 'text-secondary'} max-xxl:text-sm`}>{feature}</li>
                            ))}
                        </ul>
                        <a href={plan.buttonLink} class="btn two"><span>{plan.buttonText}<i class="fa-solid fa-arrow-right"></i></span></a>
                    </div>
                </div>
            ))}
        </div>
    </div>
    <ul class="shaps">
        <li class="absolute"><img src={shapeImages.shape1} alt="img" class="animate-fa-spin" loading="lazy"></li>
        <li class="absolute"><img src={shapeImages.shape2} alt="img" class="animate-fa-spin" loading="lazy"></li>
        <li class="absolute"><img src={shapeImages.dot1} alt="img" class="animate-fa-spin" loading="lazy"></li>
        <li class="absolute"><img src={shapeImages.dot2} alt="img" class="animate-fa-spin" loading="lazy"></li> 
    </ul>
</section>