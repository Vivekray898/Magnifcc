---
// src/components/sections/HeroBanner.astro

import { client } from '../../lib/sanity';

export interface Props {
  fetchFromSanity?: boolean;
}

const { fetchFromSanity = true } = Astro.props;

// Default fallback data
const defaultData = {
  subtitle: 'Solutions for Better Health',
  heading: 'Your Health Our Priority',
  highlightedText: 'Health',
  description: 'We are dedicated to putting your health at the forefront of everything we do. Our compassionate team of healthcare.',
  ctaText: 'Read More',
  ctaLink: '/about',
  stats: [
    { number: '500', suffix: '+', label: 'Patients Served' },
    { number: '2', suffix: 'M+', label: 'Reports Delivered' },
    { number: '100', suffix: '+', label: 'Expert Specialists' },
  ],
  teamStats: {
    number: '2000',
    suffix: '+',
    label: 'Experience Team',
  },
  heroVideoUrl: null,
};

let data = defaultData;
let videoId = null;

// Helper function to extract YouTube Video ID
const getYouTubeVideoId = (url: string) => {
  if (!url) return null;
  const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*/;
  const match = url.match(regExp);
  return (match && match[2].length === 11) ? match[2] : null;
};

// Fetch from Sanity
if (fetchFromSanity) {
  try {
    const query = `*[_type == "homePage"][0]{
      heroBanner {
        subtitle,
        heading,
        highlightedText,
        description,
        cta {
          text,
          link
        },
        stats,
        teamStats {
          number,
          suffix,
          label
        },
        heroVideoUrl,
      }
    }`;

    const result = await client.fetch(query);

    if (result?.heroBanner) {
      data = {
        ...defaultData,
        ...result.heroBanner,
        ctaText: result.heroBanner.cta?.text || defaultData.ctaText,
        ctaLink: result.heroBanner.cta?.link || defaultData.ctaLink,
        teamStats: {
          ...defaultData.teamStats,
          ...result.heroBanner.teamStats,
        },
      };

      if (result.heroBanner.heroVideoUrl) {
        videoId = getYouTubeVideoId(result.heroBanner.heroVideoUrl);
      }
    }
  } catch (error) {
    console.error('Error fetching hero banner data:', error);
  }
}

const {
  subtitle,
  heading,
  highlightedText,
  description,
  ctaText,
  ctaLink,
  stats = defaultData.stats,
  teamStats = defaultData.teamStats,
} = data;

// Helper to extract numeric value
const getNumericValue = (value: string) => {
  return parseInt(value.replace(/[^0-9]/g, '')) || 0;
};

// Helper to check if value has suffix
const hasSuffix = (value: string) => {
  return /[^0-9]/.test(value);
};

const bandStats = [
  ...stats,
  { number: teamStats.number, suffix: teamStats.suffix, label: teamStats.label },
];
---

<section class="hero-texture relative bg-[#f8f6f5] pt-100 pb-56 overflow-hidden z-10">
    <div class="container relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-40 items-center">
            
            <!-- RIGHT: VIDEO CARD (Mobile: Top) -->
            <div class="relative order-first lg:order-last">
                <!-- faint oversized pulse-line motif behind the card -->
                <svg class="absolute -top-30 -right-20 w-[110%] max-w-none opacity-[0.07] pointer-events-none hidden lg:block" height="140" viewBox="0 0 500 140" fill="none">
                    <path d="M0 70 L120 70 L145 20 L175 120 L200 70 L500 70" stroke="#021935" stroke-width="3" fill="none"/>
                </svg>

                <div class="relative z-10 rounded-2xl border border-secondary/10 bg-white p-10 shadow-[0_30px_70px_-20px_rgba(2,25,53,0.25)]">
                    {videoId ? (
                        <div class="relative w-full aspect-video rounded-xl overflow-hidden bg-secondary">
                            <iframe
                                width="100%"
                                height="100%"
                                src={`https://www.youtube.com/embed/${videoId}?autoplay=0&mute=1&loop=0&controls=1&rel=0`}
                                title="YouTube video player"
                                frameborder="0"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                allowfullscreen
                                class="block"
                            ></iframe>
                        </div>
                    ) : (
                        <img
                            src="/assets/img/hero-img.png"
                            alt="Hero Image"
                            class="w-full rounded-xl"
                            loading="lazy"
                        />
                    )}
                </div>

                <!-- corner tag -->
                <div class="absolute -bottom-14 left-24 z-20 bg-secondary text-white text-xs font-semibold px-18 py-10 rounded-lg shadow-[0_12px_30px_-8px_rgba(2,25,53,0.5)] flex items-center gap-8">
                    <span class="w-6 h-6 rounded-full bg-primary"></span>
                    Watch our story
                </div>
            </div>

            <!-- LEFT: COPY (Mobile: Bottom) -->
            <div class="grid grid-cols-1 gap-16 order-last lg:order-first">

                <!-- Editorial eyebrow -->
                <div class="flex items-center gap-10">
                    <span class="w-24 h-[2px] bg-primary"></span>
                    <span class="font-montserrat text-[11px] font-bold uppercase tracking-[0.18em] text-primary">
                        {subtitle}
                    </span>
                </div>

                <h1 class="text-3xl sm:text-4xl md:text-4.6xl xl:text-5.2xl font-bold font-sora text-secondary leading-[1.18] tracking-tight">
                    Your 
                    <span class="relative inline-block text-primary highlighted-text-wrapper">
                        {highlightedText}
                        <svg class="absolute left-0 -bottom-4 w-full" height="10" viewBox="0 0 120 10" preserveAspectRatio="none" fill="none">
                            <path d="M2 6 C 20 2, 40 8, 60 5 C 80 2, 100 8, 118 4" stroke="var(--theme-colour)" stroke-width="2.5" stroke-linecap="round" fill="none" opacity="0.55"/>
                        </svg>
                    </span> 
                    Our Priority
                </h1>

                <p class="text-base leading-27 text-gary font-normal max-w-[46ch] pt-4">
                    {description}
                </p>

                <div class="flex items-center gap-24 flex-wrap pt-14">
                    <a href={ctaLink} class="hero-cta inline-flex items-center gap-10 bg-primary text-white font-semibold text-sm px-28 py-15 rounded-lg">
                        <span>{ctaText}</span>
                        <i class="fa-solid fa-arrow-right text-xs"></i>
                    </a>

                    <div class="flex items-center gap-12">
                        <ul class="flex experience-team">
                            <li class="-ml-12 first:ml-0">
                                <img src="assets/img/team-1.png" alt="img" class="w-38 h-38 rounded-full ring-3 ring-[#f8f6f5] object-cover" />
                            </li>
                            <li class="-ml-12">
                                <img src="assets/img/team-2.png" alt="img" class="w-38 h-38 rounded-full ring-3 ring-[#f8f6f5] object-cover" />
                            </li>
                            <li class="-ml-12">
                                <img src="assets/img/team-3.png" alt="img" class="w-38 h-38 rounded-full ring-3 ring-[#f8f6f5] object-cover" />
                            </li>
                        </ul>
                        <div class="leading-tight">
                            <h6 class="font-bold text-secondary font-sora text-sm">
                                {teamStats.number}{teamStats.suffix}
                            </h6>
                            <span class="text-gary text-xs">{teamStats.label}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- STATS BAND - New Dynamic Design -->
<div class="stats-band bg-secondary py-32 relative overflow-hidden z-10">
    <div class="container">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-24">
            {bandStats.map((stat, index) => {
                const numericValue = getNumericValue(stat.number);
                const suffix = stat.suffix || '';
                const fullValue = stat.number + suffix;
                const hasSuffixChar = hasSuffix(stat.number);
                const isLast = index === bandStats.length - 1;

                return (
                    <div class={`text-center px-16 ${!isLast ? 'sm:border-r sm:border-white/10' : ''}`}>
                        <h2 class="text-3xl sm:text-4xl font-bold font-sora leading-none mb-8">
                            <span
                                class="stat-number"
                                data-target={numericValue}
                                data-suffix={suffix}
                                data-full={fullValue}
                                data-has-suffix={hasSuffixChar ? 'true' : 'false'}
                            >
                                {fullValue}
                            </span>
                        </h2>
                        <span class="text-white/75 text-xs font-medium uppercase tracking-[0.05em]">{stat.label}</span>
                    </div>
                );
            })}
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const statNumbers = document.querySelectorAll('.stat-number');

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                animateCounter(entry.target);
                observer.unobserve(entry.target);
            }
        });
    }, { threshold: 0.3 });

    statNumbers.forEach(el => {
        const hasSuffix = el.getAttribute('data-has-suffix') === 'true';
        if (!hasSuffix) {
            observer.observe(el);
        }
    });

    function animateCounter(element) {
        const target = parseInt(element.getAttribute('data-target')) || 0;
        const suffix = element.getAttribute('data-suffix') || '';
        const duration = 2000;
        const steps = 60;
        const increment = target / steps;
        let current = 0;
        let step = 0;

        if (target === 0) {
            element.textContent = '0' + suffix;
            return;
        }

        const timer = setInterval(() => {
            step++;
            current += increment;

            if (step >= steps) {
                element.textContent = target + suffix;
                clearInterval(timer);
            } else {
                element.textContent = Math.round(current) + suffix;
            }
        }, duration / steps);
    }
});

// Enhanced counter animation with dynamic styling
document.addEventListener('DOMContentLoaded', function() {
    const statNumbers = document.querySelectorAll('.stat-number');
    
    // Add dynamic class based on suffix
    statNumbers.forEach(el => {
        const suffix = el.getAttribute('data-suffix');
        if (suffix) {
            el.classList.add('has-suffix');
        }
    });
});
</script>

<style>
    /* Fix for header overlap - ensure hero section has proper positioning */
    .hero-texture {
        position: relative;
        z-index: 10;
        margin-top: 0;
        padding-top: 120px; /* Default padding for desktop */
    }
    
    /* Enhanced typography for highlighted text */
    .highlighted-text-wrapper {
        position: relative;
        display: inline-block;
        font-weight: 800;
        letter-spacing: -0.02em;
        background: linear-gradient(135deg, var(--theme-colour), #ff6b8a);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        text-shadow: none;
    }
    
    .highlighted-text-wrapper svg {
        -webkit-text-fill-color: initial;
    }
    
    .highlighted-text-wrapper svg path {
        stroke: var(--theme-colour);
        stroke-width: 3;
        opacity: 0.7;
    }

    /* Dynamic counter styles */
    .stat-number {
        display: inline-block;
        transition: all 0.3s ease;
        position: relative;
        font-weight: 800;
        letter-spacing: -0.02em;
    }
    
    .stat-number.has-suffix {
        font-size: 1.75rem;
    }
    
    .stat-number.has-suffix::after {
        content: attr(data-suffix);
        font-size: 0.6em;
        vertical-align: super;
        margin-left: 2px;
        font-weight: 700;
        color: var(--theme-colour);
        opacity: 0.8;
    }
    
    /* Dynamic color for different stat types */
    .stat-number[data-target="500"] {
        color: #ff6b6b;
    }
    
    .stat-number[data-target="2"] {
        color: #4ecdc4;
    }
    
    .stat-number[data-target="100"] {
        color: #ffe66d;
    }
    
    .stat-number[data-target="2000"] {
        color: #a8e6cf;
    }
    
    /* Pulse animation for active counters */
    .stat-number.animate-pulse {
        animation: statPulse 1.5s ease-in-out;
    }
    
    @keyframes statPulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.05); }
    }

    /* Mobile-specific adjustments */
    @media (max-width: 1023px) {
        .hero-texture {
            padding-top: 100px; /* Increased for mobile to clear header */
            padding-bottom: 40px;
        }
        
        .highlighted-text-wrapper {
            font-size: 1.1em;
        }
        
        .highlighted-text-wrapper svg {
            height: 8px;
        }
        
        .stat-number.has-suffix {
            font-size: 1.5rem;
        }
    }
    
    @media (max-width: 640px) {
        .hero-texture {
            padding-top: 90px; /* Extra padding for small mobile */
            padding-bottom: 30px;
        }
        
        .highlighted-text-wrapper {
            font-size: 1.15em;
        }
        
        .stat-number.has-suffix {
            font-size: 1.25rem;
        }
        
        .stat-number.has-suffix::after {
            font-size: 0.7em;
        }
    }
    
    /* Fix for very small screens */
    @media (max-width: 375px) {
        .hero-texture {
            padding-top: 100px;
        }
    }

    /* Base styles */
    .hero-texture::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle, rgba(2, 25, 53, 0.05) 1.5px, transparent 0);
        background-size: 26px 26px;
        -webkit-mask-image: linear-gradient(to bottom, black, transparent 85%);
        mask-image: linear-gradient(to bottom, black, transparent 85%);
        pointer-events: none;
    }

    .hero-cta {
        box-shadow: 0 14px 30px -10px rgba(225, 29, 72, 0.45);
        transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    }
    
    .hero-cta:hover {
        transform: translateY(-2px);
        box-shadow: 0 18px 36px -8px rgba(225, 29, 72, 0.55);
        background-color: var(--common-colour);
    }

    .stats-band::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--theme-colour), transparent);
        opacity: 0.6;
    }
    
    /* Gradient border for stats on mobile */
    @media (max-width: 640px) {
        .stats-band .grid > div:not(:last-child) {
            border-bottom: 1px solid rgba(255,255,255,0.05);
            padding-bottom: 20px;
        }
        
        .stats-band .grid > div:nth-child(2) {
            border-bottom: none;
        }
    }
    
    /* Ensure header doesn't overlap */
    header + .hero-texture {
        margin-top: 0;
    }
</style>