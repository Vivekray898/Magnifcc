---
// src/components/sections/HeroBanner.astro

import { client } from '../../lib/sanity';

export interface Props {
  fetchFromSanity?: boolean;
}

const { fetchFromSanity = true } = Astro.props;

// Default fallback data
const defaultData = {
  subtitle: 'Solutions for Better Health',
  heading: 'Your Health Our Priority',
  highlightedText: 'Health',
  description: 'We are dedicated to putting your health at the forefront of everything we do. Our compassionate team of healthcare.',
  ctaText: 'Read More',
  ctaLink: '/about',
  stats: [
    { number: '500', suffix: '+', label: 'Patients Served' },
    { number: '2', suffix: 'M+', label: 'Reports Delivered' },
    { number: '100', suffix: '+', label: 'Expert Specialists' },
  ],
  teamStats: {
    number: '2000',
    suffix: '+',
    label: 'Experience Team',
  },
  heroImage: null,
};

let data = defaultData;
let heroImageUrl = '/assets/img/hero-img.png';

// Fetch from Sanity
if (fetchFromSanity) {
  try {
    const query = `*[_type == "homePage"][0]{
      heroBanner {
        subtitle,
        heading,
        highlightedText,
        description,
        cta {
          text,
          link
        },
        stats,
        teamStats {
          number,
          suffix,
          label
        },
        heroImage {
          asset->{
            _id,
            url
          }
        }
      }
    }`;
    
    const result = await client.fetch(query);
    
    if (result?.heroBanner) {
      data = {
        ...defaultData,
        ...result.heroBanner,
        ctaText: result.heroBanner.cta?.text || defaultData.ctaText,
        ctaLink: result.heroBanner.cta?.link || defaultData.ctaLink,
        teamStats: {
          ...defaultData.teamStats,
          ...result.heroBanner.teamStats,
        },
      };
      
      if (result.heroBanner.heroImage?.asset?.url) {
        heroImageUrl = result.heroBanner.heroImage.asset.url;
      }
    }
  } catch (error) {
    console.error('Error fetching hero banner data:', error);
  }
}

const {
  subtitle,
  heading,
  highlightedText,
  description,
  ctaText,
  ctaLink,
  stats = defaultData.stats,
  teamStats = defaultData.teamStats,
} = data;

// Helper to extract numeric value
const getNumericValue = (value: string) => {
  return parseInt(value.replace(/[^0-9]/g, '')) || 0;
};

// Helper to check if value has suffix
const hasSuffix = (value: string) => {
  return /[^0-9]/.test(value);
};
---

<section class="bg-[#F4F4FF] pt-100 overflow-hidden">
    <div class="container">
        <div class="grid grid-cols-12 items-center">
            <div class="lg:col-span-6 col-span-12">
                <div class="relative">
                    <span class="xxl:text-xxl sm:text-lg text-sm uppercase font-bold text-secondary">
                        <i class="fa-solid fa-heart pr-10 text-[#FC4F4F]"></i>
                        {subtitle}
                    </span>
                    <div class="relative">
                        <h1 class="xxl:text-7.5xl xl:text-6xl md:text-5.2xl sm:text-4.3xl text-4.75xl font-bold mb-20 uppercase font-sora text-secondary leading-[1.2]">
                            Your <span class="text-primary">{highlightedText}</span> Our Priority
                        </h1>
                        <img 
                            src="assets/img/shaps-3.png" 
                            alt="img" 
                            class="absolute xl:-top-40 -top-26 xxl:right-0 xl:right-66 lg:right-55 md:right-148 sm:right-50 right-8 shaps-3 animate-bellring max-xl:w-50"
                        />
                    </div>	
                    <p class="xxl:text-xxl xl:text-xl text-lg leading-32 xl:leading-34 pb-45 text-gary font-normal">
                        {description}
                    </p>
                    <div class="flex items-center gap-18 max-xl:flex-wrap">
                        <a href={ctaLink} class="btn">
                            <span>{ctaText}<i class="fa-solid fa-arrow-right"></i></span>
                        </a>
                        <ul class="flex ml-14 experience-team">
                            <li class="-ml-15">
                                <img src="assets/img/team-1.png" alt="img" class="max-xxl:w-50" />
                            </li>
                            <li class="-ml-15">
                                <img src="assets/img/team-2.png" alt="img" class="max-xxl:w-50" />
                            </li>
                            <li class="-ml-15">
                                <img src="assets/img/team-3.png" alt="img" class="max-xxl:w-50" />
                            </li>
                            <li class="-ml-15">
                                <a href="javascript:void(0);" class="flex items-center justify-center w-12 h-12 bg-primary text-white rounded-full text-lg font-bold">+</a>
                            </li>
                        </ul>
                        <div>
                            <h6 class="font-bold text-secondary font-sora text-base">
                                {teamStats.number}{teamStats.suffix}
                            </h6>
                            <span class="text-secondary max-xxl:text-xs">{teamStats.label}</span>
                        </div>
                    </div>
                </div>
                <div class="flex xl:gap-60 sm:gap-40 gap-20 pt-50">
                    {stats?.map((stat, index) => {
                        const numericValue = getNumericValue(stat.number);
                        const suffix = stat.suffix || '';
                        const fullValue = stat.number + suffix;
                        const hasSuffixChar = hasSuffix(stat.number);
                        
                        return (
                            <div key={index}>
                                <h2 class="xl:text-5.2xl md:text-4.65xl text-2.3xl font-bold text-secondary font-sora">
                                    <span 
                                        class="stat-number" 
                                        data-target={numericValue}
                                        data-suffix={suffix}
                                        data-full={fullValue}
                                        data-has-suffix={hasSuffixChar ? 'true' : 'false'}
                                    >
                                        {fullValue}
                                    </span>
                                </h2>
                                <span class="text-secondary max-md:text-xs max-md:leading-18 max-md:block">{stat.label}</span>
                            </div>
                        );
                    })}
                </div>
            </div>
            <div class="lg:col-span-6 col-span-12">
                <div class="relative">
                    <img 
                        src={heroImageUrl} 
                        alt="Hero Image" 
                        class="4xl:max-w-[125%] max-xl:mt-150 max-lg:mt-50"
                        loading="lazy"
                    />
                    <ul class="shaps">
                        <li class="absolute">
                            <img src="assets/img/shaps-1.png" alt="img" class="max-w-[125%] animate-topshap max-md:w-70" />
                        </li>
                        <li class="absolute">
                            <img src="assets/img/shaps-2.png" alt="img" class="max-w-[125%] animate-topshap max-md:w-130 max-sm:w-70" />
                        </li>
                        <li class="absolute">
                            <img src="assets/img/shaps-4.png" alt="img" class="max-w-[125%] animate-fa-spin" />
                        </li>
                        <li class="absolute">
                            <img src="assets/img/shaps-5.png" alt="img" class="max-w-[125%] animate-fa-spin" />
                        </li>
                        <li class="absolute">
                            <img src="assets/img/shaps-6.png" alt="img" class="max-w-[125%] animate-fa-spin" />
                        </li>
                    </ul>
                </div> 
            </div>
        </div>
    </div>
</section>

<script>
// Counter animation
document.addEventListener('DOMContentLoaded', function() {
    const statNumbers = document.querySelectorAll('.stat-number');
    
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                animateCounter(entry.target);
                observer.unobserve(entry.target);
            }
        });
    }, { threshold: 0.3 });
    
    statNumbers.forEach(el => {
        const hasSuffix = el.getAttribute('data-has-suffix') === 'true';
        if (!hasSuffix) {
            observer.observe(el);
        }
    });
    
    function animateCounter(element) {
        const target = parseInt(element.getAttribute('data-target')) || 0;
        const suffix = element.getAttribute('data-suffix') || '';
        const duration = 2000;
        const steps = 60;
        const increment = target / steps;
        let current = 0;
        let step = 0;
        
        if (target === 0) {
            element.textContent = '0' + suffix;
            return;
        }
        
        const timer = setInterval(() => {
            step++;
            current += increment;
            
            if (step >= steps) {
                element.textContent = target + suffix;
                clearInterval(timer);
            } else {
                element.textContent = Math.round(current) + suffix;
            }
        }, duration / steps);
    }
});
</script>

<style>
    .stat-number {
        display: inline-block;
        transition: all 0.3s ease;
    }
</style>