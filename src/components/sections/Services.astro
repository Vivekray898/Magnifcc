---
// src/components/sections/Services.astro

import { client } from '../../lib/sanity';

export interface Props {
  fetchFromSanity?: boolean;
  data?: {
    subtitle?: string;
    title?: string;
    services?: Array<{
      title: string;
      description: string;
      iconBgColor: string;
      iconShadow?: string;
      link: string;
      slug?: string;
    }>;
  };
}

const { fetchFromSanity = true, data: propData } = Astro.props;

// Default fallback data
const defaultData = {
  subtitle: 'Our Services',
  title: 'Our Medical Services.',
  services: [
    {
      title: 'Mental Health',
      description: 'Our comprehensive preventive care services are designed to identify potential.',
      iconBgColor: 'var(--theme-colour)',
      iconShadow: 'rgba(166,12,19,0.4)',
      link: '/services/mental-health',
      slug: 'mental-health',
    },
    {
      title: 'Preventive Care',
      description: 'Our comprehensive preventive care services are designed to identify potential.',
      iconBgColor: 'var(--theme-colour)',
      iconShadow: 'rgba(166,12,19,0.4)',
      link: '/services/preventive-care',
      slug: 'preventive-care',
    },
    {
      title: 'Surgical Care',
      description: 'Our comprehensive preventive care services are designed to identify potential.',
      iconBgColor: 'var(--theme-colour)',
      iconShadow: 'rgba(166,12,19,0.4)',
      link: '/services/surgical-care',
      slug: 'surgical-care',
    },
    {
      title: 'Dental Checkup',
      description: 'Our comprehensive preventive care services are designed to identify potential.',
      iconBgColor: 'var(--theme-colour)',
      iconShadow: 'rgba(166,12,19,0.4)',
      link: '/services/dental-checkup',
      slug: 'dental-checkup',
    },
  ],
};

let sectionData = { subtitle: defaultData.subtitle, title: defaultData.title };
let services = defaultData.services;

// Helper function to truncate description
const truncateDescription = (text: string, maxLength: number = 60): string => {
  if (!text) return 'Service description';
  if (text.length <= maxLength) return text;
  return text.substring(0, maxLength) + '...';
};

// Fetch from Sanity
if (fetchFromSanity && !propData) {
  try {
    // First, fetch the section settings from homePage
    const settingsQuery = `*[_type == "homePage"][0]{
      servicesSection {
        subtitle,
        title
      }
    }`;
    
    const settingsResult = await client.fetch(settingsQuery);
    
    if (settingsResult?.servicesSection) {
      sectionData = {
        subtitle: settingsResult.servicesSection.subtitle || defaultData.subtitle,
        title: settingsResult.servicesSection.title || defaultData.title,
      };
    }
    
    // Then, fetch all services from servicesDetails
    const servicesQuery = `*[_type == "servicesDetails"]{
      title,
      description,
      slug,
      iconBgColor,
      iconShadow
    } | order(title asc)`;
    
    const servicesResult = await client.fetch(servicesQuery);
    
    if (servicesResult && servicesResult.length > 0) {
      services = servicesResult.map((service: any, index: number) => ({
        title: service.title || 'Untitled Service',
        description: truncateDescription(service.description, 60),
        iconBgColor: service.iconBgColor || 'var(--theme-colour)',
        iconShadow: service.iconShadow || 'rgba(166,12,19,0.4)',
        link: `/services/${service.slug?.current || 'service'}`,
        slug: service.slug?.current || `service-${index + 1}`,
      }));
    }
  } catch (error) {
    console.error('Error fetching services data:', error);
  }
} else if (propData) {
  sectionData = {
    subtitle: propData.subtitle || defaultData.subtitle,
    title: propData.title || defaultData.title,
  };
  services = propData.services?.length > 0 ? propData.services : defaultData.services;
}

const { subtitle, title } = sectionData;
---

<section class="bg-[#f8f6f5] lg:pt-80 md:pt-60 pb-50 pt-50">
  <div class="container">
    <div class="pb-24 md:pb-32 w-[fit-content]">
      <div class="flex items-center gap-10 mb-8">
        <span class="w-24 h-[2px] bg-primary"></span>
        <span class="font-montserrat text-[11px] font-bold uppercase tracking-[0.18em] text-primary">{subtitle}</span>
      </div>
      <h2 class="xl:text-4xl md:text-3.5xl sm:text-3xl text-2.3xl font-semibold text-secondary font-sora leading-[1.2]">{title}</h2>
    </div>
    
    <!-- Services Grid - 4 columns -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {services?.map((service, index) => (
        <div class="group h-full" key={index}>
          <div class="services-box shadow-[0px_0px_12px_0px_rgba(2,25,53,0.06)] relative p-22 xxl:p-24 rounded-[10px] before:w-full before:h-0 before:bg-primary before:absolute before:bottom-0 before:left-0 group-hover:before:h-full before:duration-500 h-full flex flex-col pb-6 overflow-hidden bg-white hover:translate-y-[-4px] transition-all duration-300">
            {/* Icon with gradient background */}
            <div class="icon-circle size-52 flex items-center justify-center mb-16 relative rounded-full group-hover:bg-white flex-shrink-0"
                 style={{
                   background: `var(--theme-colour)`,
                   boxShadow: `0px 0px 16px 0px rgba(166,12,19,0.4)`
                 }}>
              <svg class="w-6 h-6 text-white group-hover:text-secondary transition-colors duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            
            <h4 class="font-sora text-secondary font-medium leading-[1.2] flex-shrink-0">
              <a href={service.link || 'services-details.html'} class="text-lg xl:text-xl font-bold font-sora relative text-secondary group-hover:text-white duration-500">
                {service.title}
              </a>
            </h4>
            <p class="pt-8 pb-14 relative text-sm leading-22 text-[#6f6f6f] font-normal group-hover:text-white duration-500 flex-grow">
              {service.description}
            </p>
            <a href={service.link || 'services-details.html'} class="relative text-sm font-bold text-secondary font-sora group-hover:text-white duration-500 inline-flex items-center gap-2 flex-shrink-0 mt-auto">
              Read More <i class="fa-solid fa-arrow-right text-xs relative"></i>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  :root {
    --theme-colour: #a60c13;
    --theme-colour-hover: #88080d;
  }

  .services-box {
    border-radius: 10px;
    overflow: hidden;
    transition: all 0.4s ease;
    background: white;
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    z-index: 1;
  }
  
  .services-box::before {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 0;
    background: var(--theme-colour);
    transition: height 0.5s ease;
    z-index: -1;
  }
  
  .services-box:hover::before {
    height: 100%;
  }
  
  .services-box:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(166, 12, 19, 0.15);
  }
  
  .services-box .icon-circle {
    transition: all 0.4s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--theme-colour) !important;
  }
  
  .services-box .icon-circle svg {
    transition: all 0.4s ease;
    width: 24px;
    height: 24px;
  }
  
  .services-box:hover .icon-circle {
    background-color: white !important;
  }
  
  .services-box:hover .icon-circle svg {
    color: var(--theme-colour) !important;
    stroke: var(--theme-colour) !important;
  }
  
  .services-box h4 a {
    transition: color 0.3s ease;
  }
  
  .services-box h4 a:hover {
    color: var(--theme-colour) !important;
  }

  /* Responsive adjustments */
  @media (max-width: 640px) {
    .services-box {
      padding: 20px;
    }
    
    .services-box .icon-circle {
      width: 44px;
      height: 44px;
    }
    
    .services-box .icon-circle svg {
      width: 20px;
      height: 20px;
    }
  }
  
  @media (min-width: 641px) and (max-width: 1024px) {
    .services-box {
      padding: 22px;
    }
  }
</style>