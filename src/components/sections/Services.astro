---
// src/components/sections/Services.astro

import { client } from '../../lib/sanity';

export interface Props {
  fetchFromSanity?: boolean;
  data?: {
    subtitle?: string;
    title?: string;
    services?: Array<{
      title: string;
      description: string;
      iconBgColor: string;
      iconShadow?: string;
      link: string;
      slug?: string;
    }>;
  };
}

const { fetchFromSanity = true, data: propData } = Astro.props;

// Default fallback data
const defaultData = {
  subtitle: '# Our Services',
  title: 'Our Medical Services.',
  services: [
    {
      title: 'Mental Health',
      description: 'Our comprehensive preventive care services are designed to identify potential.',
      iconBgColor: 'rgb(240,93,193)',
      iconShadow: 'rgba(240,93,168,0.4)',
      link: '/services/mental-health',
      slug: 'mental-health',
    },
    {
      title: 'Preventive Care',
      description: 'Our comprehensive preventive care services are designed to identify potential.',
      iconBgColor: '#69b741',
      iconShadow: 'rgba(105,183,65,0.4)',
      link: '/services/preventive-care',
      slug: 'preventive-care',
    },
    {
      title: 'Surgical Care',
      description: 'Our comprehensive preventive care services are designed to identify potential.',
      iconBgColor: '#58CBF2',
      iconShadow: 'rgba(88,203,242,0.4)',
      link: '/services/surgical-care',
      slug: 'surgical-care',
    },
    {
      title: 'Dental Checkup',
      description: 'Our comprehensive preventive care services are designed to identify potential.',
      iconBgColor: '#9B52E1',
      iconShadow: 'rgba(155,82,225,0.4)',
      link: '/services/dental-checkup',
      slug: 'dental-checkup',
    },
  ],
};

let sectionData = { subtitle: defaultData.subtitle, title: defaultData.title };
let services = defaultData.services;

// Helper function to truncate description
const truncateDescription = (text: string, maxLength: number = 60): string => {
  if (!text) return 'Service description';
  if (text.length <= maxLength) return text;
  return text.substring(0, maxLength) + '...';
};

// Fetch from Sanity
if (fetchFromSanity && !propData) {
  try {
    // First, fetch the section settings from homePage
    const settingsQuery = `*[_type == "homePage"][0]{
      servicesSection {
        subtitle,
        title
      }
    }`;
    
    const settingsResult = await client.fetch(settingsQuery);
    
    if (settingsResult?.servicesSection) {
      sectionData = {
        subtitle: settingsResult.servicesSection.subtitle || defaultData.subtitle,
        title: settingsResult.servicesSection.title || defaultData.title,
      };
    }
    
    // Then, fetch all services from servicesDetails
    const servicesQuery = `*[_type == "servicesDetails"]{
      title,
      description,
      slug,
      iconBgColor,
      iconShadow
    } | order(title asc)`;
    
    const servicesResult = await client.fetch(servicesQuery);
    
    if (servicesResult && servicesResult.length > 0) {
      services = servicesResult.map((service: any) => ({
        title: service.title || 'Untitled Service',
        description: truncateDescription(service.description, 60),
        iconBgColor: service.iconBgColor || '#F05DA8',
        iconShadow: service.iconShadow || 'rgba(240,93,168,0.4)',
        link: `/services/${service.slug?.current || 'service'}`,
        slug: service.slug?.current || `service-${index + 1}`,
      }));
    }
  } catch (error) {
    console.error('Error fetching services data:', error);
  }
} else if (propData) {
  sectionData = {
    subtitle: propData.subtitle || defaultData.subtitle,
    title: propData.title || defaultData.title,
  };
  services = propData.services?.length > 0 ? propData.services : defaultData.services;
}

const { subtitle, title } = sectionData;
---

<section class="lg:pt-120 md:pt-80 pt-60">
  <div class="container">
    <div class="xl:pb-50 lg:pb-40 pb-30 w-[fit-content]"> 
      <span class="capitalize font-semibold xxl:text-xxl xl:text-xl sm:text-lg text-base text-primary font-sora pb-5 block">{subtitle}</span>
      <h2 class="xl:text-5xl md:text-4xl sm:text-3xl text-2.5xl font-semibold text-secondary font-sora leading-[1.2]">{title}</h2> 
    </div>
    <div class="swiper services-slider">
      <div class="swiper-wrapper">
        {services?.map((service, index) => (
          <div class="swiper-slide group" key={index}>
            <div class="services-box shadow-[0px_0px_15px_0px_rgba(0,0,0,0.07)] relative xxl:p-40 p-30 xxl:m-15 m-10 before:w-full before:h-0 before:bg-primary before:absolute before:bottom-0 before:left-0 group-hover:before:h-full before:duration-500">
              {/* Icon with gradient background - no numbers */}
              <div class="size-90 flex items-center justify-center mb-25 relative rounded-full group-hover:bg-white" 
                   style={{
                     background: `linear-gradient(135deg, ${service.iconBgColor || '#F05DA8'}, ${service.iconBgColor || '#F05DA8'}dd)`,
                     boxShadow: `0px 0px 24px 0px ${service.iconShadow || 'rgba(240,93,168,0.4)'}`
                   }}>
                <svg class="w-10 h-10 text-white group-hover:text-secondary transition-colors duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              
              <h4 class="xl:text-xl font-sora text-secondary font-medium leading-[1.2]">
                <a href={service.link || 'services-details.html'} class="xxl:text-2xl text-xl font-bold font-sora relative text-secondary group-hover:text-white duration-500">
                  {service.title}
                </a>
              </h4>
              <p class="pt-10 pb-20 relative text-base leading-32 text-[#6f6f6f] font-normal group-hover:text-white duration-500">
                {service.description}
              </p>
              <a href={service.link || 'services-details.html'} class="relative font-bold text-secondary font-sora group-hover:text-white duration-500 inline-flex items-center gap-2">
                Read More <i class="fa-solid fa-arrow-right relative"></i>
              </a>
            </div>
          </div>
        ))}
      </div>
      <div class="swiper-button">
        <div class="services-swiper-button-next"><i class="fa-solid fa-arrow-right"></i></div>
        <div class="services-swiper-button-prev"><i class="fa-solid fa-arrow-left"></i></div>
      </div>
    </div> 
  </div>
</section>

<style>
  .services-box {
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.5s ease;
    background: white;
  }
  
  .services-box:hover {
    transform: translateY(-5px);
  }
  
  .services-box .size-90 {
    transition: all 0.5s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .services-box .size-90 svg {
    transition: all 0.5s ease;
    width: 40px;
    height: 40px;
  }
  
  .services-box:hover .size-90 {
    background-color: white !important;
  }
  
  .services-box:hover .size-90 svg {
    color: #021935 !important;
    stroke: #021935;
  }
  
  .services-box h4 a {
    transition: color 0.3s ease;
  }
  
  .services-box h4 a:hover {
    color: #F05DA8 !important;
  }
  
  /* Swiper button styles */
  .services-swiper-button-next,
  .services-swiper-button-prev {
    width: 50px;
    height: 50px;
    background: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    cursor: pointer;
    transition: all 0.3s ease;
    color: #021935;
    font-size: 18px;
  }
  
  .services-swiper-button-next:hover,
  .services-swiper-button-prev:hover {
    background: #F05DA8;
    color: white;
  }
  
  .swiper-button {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 30px;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const swiperEl = document.querySelector('.services-slider');
    if (!swiperEl) return;
    
    if (typeof Swiper === 'undefined') {
      console.warn('Swiper library not loaded');
      return;
    }
    
    const slides = swiperEl.querySelectorAll('.swiper-slide');
    const slidesPerView = slides.length < 3 ? slides.length : 3;
    
    new Swiper(swiperEl, {
      slidesPerView: 1,
      spaceBetween: 20,
      loop: slides.length > 2,
      navigation: {
        nextEl: '.services-swiper-button-next',
        prevEl: '.services-swiper-button-prev',
      },
      breakpoints: {
        640: {
          slidesPerView: Math.min(2, slides.length),
          spaceBetween: 20,
        },
        768: {
          slidesPerView: Math.min(2, slides.length),
          spaceBetween: 30,
        },
        1024: {
          slidesPerView: Math.min(3, slides.length),
          spaceBetween: 30,
        },
        1280: {
          slidesPerView: Math.min(3, slides.length),
          spaceBetween: 40,
        },
      },
    });
  });
</script>