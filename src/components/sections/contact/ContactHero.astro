---
// src/components/sections/contact/ContactHero.astro

import { client } from '../../../lib/sanity';
import { imageUrlFor } from '../../../lib/sanity-image';

export interface Props {
  fetchFromSanity?: boolean;
  title?: string;
  subtitle?: string;
  image?: string;
  backgroundImage?: string;
}

const { 
  fetchFromSanity = true,
  title = "contact us",
  subtitle = "contact us",
  image = "/assets/img/bannr-img-3.png",
  backgroundImage = "",
} = Astro.props;

let data = { 
  title, 
  subtitle, 
  image, 
  backgroundImage 
};
let imageUrl = image;
let bgImageUrl = backgroundImage;

// Fetch from Sanity
if (fetchFromSanity) {
  try {
    const query = `*[_type == "contactPage"][0]{
      heroSection {
        title,
        subtitle,
        image {
          asset->{
            _id,
            url
          }
        },
        backgroundImage {
          asset->{
            _id,
            url
          }
        }
      }
    }`;
    
    const result = await client.fetch(query);
    
    if (result?.heroSection) {
      data = { ...data, ...result.heroSection };
      
      if (result.heroSection.image?.asset?.url) {
        imageUrl = result.heroSection.image.asset.url;
      }
      
      if (result.heroSection.backgroundImage?.asset?.url) {
        bgImageUrl = result.heroSection.backgroundImage.asset.url;
      }
    }
  } catch (error) {
    console.error('Error fetching contact hero data:', error);
  }
}

// Determine background style
const bgStyle = bgImageUrl 
  ? `background-image: url(${bgImageUrl}); background-size: cover; background-position: center; background-repeat: no-repeat;`
  : 'background: #f4f4f4;';
---

<section 
  class="pt-90 relative about-banner overflow-hidden" 
  style={bgStyle}
>
  {!bgImageUrl && (
    <div class="absolute inset-0 bg-[#f4f4f4] -z-10"></div>
  )}
  
  <div class="container relative z-10">
    <div class="row items-center">
      <div class="lg:w-1/2 w-full">
        <div class="relative max-md:text-center">
          <h2 class="xxl:text-7.7xl xl:text-6.3xl md:text-5.2xl sm:text-4.75xl text-4.6xl font-bold capitalize font-sora text-secondary leading-[1.2]">
            {data.title}
          </h2>
        </div>
        <ol class="mb-16 flex items-center max-md:justify-center max-md:mb-40 pt-10">
          <li class="xxl:text-xxl md:text-xl text-sm text-secondary font-sora capitalize">
            <a href="/"> Home </a>
          </li>
          <li 
            class="xxl:text-xxl md:text-xl text-sm text-gary capitalize before:content-['-'] before:float-left before:text-gary before:px-10" 
            aria-current="page"
          >
            {data.subtitle}
          </li>
        </ol>
      </div>
      <div class="lg:w-1/2 w-full">
        <div>
          <img 
            src={imageUrl} 
            alt="Contact Us" 
            class="w-[120%] xxl:max-w-[unset]"
            loading="lazy"
          >
        </div>
      </div>
    </div>
  </div>
</section>