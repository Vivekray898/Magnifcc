---
// src/components/sections/Portfolio.astro
import { client } from '../../lib/sanity';

export interface Props {
  fetchFromSanity?: boolean;
  darkMode?: boolean;
}

const { fetchFromSanity = true, darkMode = false } = Astro.props;

// Default portfolio items (fallback)
const defaultPortfolioItems = [
  { id: 1, image: '/assets/img/dental-project-1.jpg', category: 'Treatments', title: 'Dr. Jonathan', link: '/portfolio-details' },
  { id: 2, image: '/assets/img/dental-project-2.jpg', category: 'Treatments', title: 'Dr. David', link: '/portfolio-details' },
  { id: 3, image: '/assets/img/dental-project-3.jpg', category: 'Treatments', title: 'Dr. Sarah', link: '/portfolio-details' },
  { id: 4, image: '/assets/img/dental-project-4.jpg', category: 'Treatments', title: 'Dr. Michael', link: '/portfolio-details' },
];

let portfolioItems = defaultPortfolioItems;
let subtitle = '# Dental Portfolio';
let title = 'A Portfolio of Smiles.';

if (fetchFromSanity) {
  try {
    const query = `*[_type == "portfolio"] | order(_createdAt desc) {
      _id,
      title,
      category,
      slug,
      image {
        asset-> {
          _id,
          url
        }
      }
    }`;

    const result = await client.fetch(query);

    const sectionQuery = `*[_type == "homePage"][0]{
      portfolioSection {
        subtitle,
        title
      }
    }`;

    const sectionResult = await client.fetch(sectionQuery);

    if (sectionResult?.portfolioSection) {
      if (sectionResult.portfolioSection.subtitle) subtitle = sectionResult.portfolioSection.subtitle;
      if (sectionResult.portfolioSection.title) title = sectionResult.portfolioSection.title;
    }

    if (result && result.length > 0) {
      portfolioItems = result.map((item: any) => ({
        id: item._id,
        image: item.image?.asset?.url || '/assets/img/dental-project-1.jpg',
        category: item.category || 'Treatments',
        title: item.title || 'Dr. Name',
        link: `/portfolio/${item.slug?.current || 'details'}`,
      }));
    }
  } catch (error) {
    console.error('Error fetching portfolio data:', error);
  }
}

const sectionClasses = darkMode
  ? 'xl:py-120 lg:py-100 sm:py-80 py-60 section-portfolio dark-mode'
  : 'xl:py-120 lg:py-100 sm:py-80 py-60 section-portfolio';
---

<section class={sectionClasses}>
  <div class="container">
    <!-- Section Header -->
    <div class="flex items-end justify-between flex-wrap gap-4 xl:pb-50 lg:pb-40 pb-30">
      <div class="w-[fit-content]">
        <span class="capitalize font-semibold xxl:text-xxl xl:text-xl sm:text-lg text-base text-primary font-sora pb-6 block">{subtitle}</span>
        <h2 class="xl:text-5xl md:text-4xl sm:text-3xl text-2.5xl font-semibold text-secondary font-sora leading-[1.2]">{title}</h2>
      </div>
      <a href="/portfolio" class="text-primary font-semibold font-sora hover:text-secondary transition-colors duration-300 flex items-center gap-2">
        View All <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>

    <!-- Portfolio Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-25">
      {portfolioItems.map((item) => (
        <a href={item.link} class="portfolio-card group block">
          <!-- White outer frame -->
          <div class="card-frame">
            <div class="card-inner">
              <!-- Image -->
              <img src={item.image} alt={item.title} loading="lazy" />

              <!-- Frosted-glass blur at bottom (like reference) -->
              <div class="card-blur" aria-hidden="true"></div>
              <!-- Soft dark gradient for text readability -->
              <div class="card-gradient" aria-hidden="true"></div>

              <!-- Bottom content: title/subtitle left, circle arrow right -->
              <div class="card-content">
                <div class="card-text">
                  <h3>{item.title}</h3>
                  <p>{item.category}</p>
                </div>
                <span class="card-arrow" aria-hidden="true">
                  <i class="fa-solid fa-arrow-right"></i>
                </span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style is:global>
/* ===== PORTFOLIO SECTION ===== */
.section-portfolio {
  position: relative;
  background: var(--color-offwhite);
  transition: background 0.3s ease;
}

.section-portfolio.dark-mode {
  background: var(--color-secondary);
}

.section-portfolio.dark-mode h2 {
  color: var(--color-white) !important;
}

.section-portfolio.dark-mode span:not(.text-primary) {
  color: var(--color-lightgary) !important;
}

/* ===== PORTFOLIO CARD (reference design) ===== */
.portfolio-card {
  text-decoration: none;
  cursor: pointer;
}

/* White rounded frame around the image */
.portfolio-card .card-frame {
  background: var(--color-white, #ffffff);
  padding: 10px;
  border-radius: 28px;
  box-shadow: 0 15px 45px rgba(0, 0, 0, 0.08);
  transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1),
              box-shadow 0.45s cubic-bezier(0.4, 0, 0.2, 1);
}

.portfolio-card:hover .card-frame {
  transform: translateY(-10px);
  box-shadow: 0 30px 70px rgba(0, 0, 0, 0.15);
}

/* Inner rounded image area — near-square like the mock */
.portfolio-card .card-inner {
  position: relative;
  border-radius: 20px;
  overflow: hidden;
  aspect-ratio: 1 / 1.05;
  background: #e5e7eb;
}

.portfolio-card .card-inner img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
}

.portfolio-card:hover .card-inner img {
  transform: scale(1.07);
}

/* Frosted glass blur fading out towards the top */
.portfolio-card .card-blur {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 45%;
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  -webkit-mask-image: linear-gradient(to top, #000 55%, transparent);
  mask-image: linear-gradient(to top, #000 55%, transparent);
  pointer-events: none;
}

/* Subtle dark gradient so white text always reads */
.portfolio-card .card-gradient {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top,
              rgba(0, 0, 0, 0.45) 0%,
              rgba(0, 0, 0, 0.15) 45%,
              transparent 70%);
  pointer-events: none;
}

/* Bottom row: text left + circle button right */
.portfolio-card .card-content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 26px;
}

.portfolio-card .card-text h3 {
  color: #ffffff;
  font-family: 'Sora', sans-serif;
  font-size: 24px;
  font-weight: 700;
  line-height: 1.25;
  margin: 0 0 6px;
}

.portfolio-card .card-text p {
  color: rgba(255, 255, 255, 0.85);
  font-size: 16px;
  font-weight: 400;
  margin: 0;
}

/* White circular arrow button */
.portfolio-card .card-arrow {
  flex: 0 0 auto;
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background: #ffffff;
  color: #101010;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
  transition: background 0.35s ease, color 0.35s ease, transform 0.35s ease;
}

.portfolio-card .card-arrow i {
  transition: transform 0.35s ease;
}

.portfolio-card:hover .card-arrow {
  background: var(--theme-colour, #F05DA8);
  color: #ffffff;
  transform: scale(1.05);
}

.portfolio-card:hover .card-arrow i {
  transform: rotate(-45deg);
}

/* Dark mode frame */
.section-portfolio.dark-mode .portfolio-card .card-frame {
  background: #23252b;
  box-shadow: 0 15px 45px rgba(0, 0, 0, 0.35);
}

/* ===== BUTTON ===== */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 36px;
  border-radius: 50px;
  font-weight: 600;
  font-family: 'Sora', sans-serif;
  transition: all 0.4s ease;
  background: var(--theme-colour, #F05DA8);
  color: #ffffff !important;
  text-decoration: none;
  border: none;
  cursor: pointer;
  position: relative;
  z-index: 1;
}

.btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 15px 40px rgba(240, 93, 168, 0.3);
  opacity: 0.9;
  color: #ffffff !important;
}

.btn i {
  transition: transform 0.3s ease;
}

.btn:hover i {
  transform: translateX(5px);
}

/* ===== RESPONSIVE ===== */
@media (max-width: 1200px) {
  .portfolio-card .card-content { padding: 20px; }
  .portfolio-card .card-text h3 { font-size: 20px; }
  .portfolio-card .card-text p { font-size: 14px; }
  .portfolio-card .card-arrow { width: 52px; height: 52px; font-size: 18px; }
}

@media (max-width: 640px) {
  .portfolio-card .card-frame { padding: 8px; border-radius: 22px; }
  .portfolio-card .card-inner { border-radius: 16px; aspect-ratio: 1 / 1; }
  .portfolio-card .card-content { padding: 18px; }
  .portfolio-card .card-text h3 { font-size: 18px; margin-bottom: 4px; }
  .portfolio-card .card-text p { font-size: 13px; }
  .portfolio-card .card-arrow { width: 46px; height: 46px; font-size: 16px; }
}

/* Container */
.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 15px;
}
</style>