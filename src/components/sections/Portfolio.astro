---
// src/components/sections/Portfolio.astro

import { client } from '../../lib/sanity';

export interface Props {
  fetchFromSanity?: boolean;
  darkMode?: boolean;
}

const { fetchFromSanity = true, darkMode = false } = Astro.props;

// Default portfolio items (fallback)
const defaultPortfolioItems = [
    {
        id: 1,
        image: "/assets/img/dental-project-1.jpg",
        category: "Treatments",
        title: "Dr. Jonathan",
        link: "/portfolio-details"
    },
    {
        id: 2,
        image: "/assets/img/dental-project-2.jpg",
        category: "Treatments",
        title: "Dr. David",
        link: "/portfolio-details"
    },
    {
        id: 3,
        image: "/assets/img/dental-project-3.jpg",
        category: "Treatments",
        title: "Dr. Ayesha",
        link: "/portfolio-details"
    },
    {
        id: 4,
        image: "/assets/img/dental-project-2.jpg",
        category: "Treatments",
        title: "Dr. Michael",
        link: "/portfolio-details"
    }
];

let portfolioItems = defaultPortfolioItems;
let subtitle = '# Dental Portfolio';
let title = 'A Portfolio of Smiles.';

// Fetch from Sanity - directly from portfolio documents
if (fetchFromSanity) {
  try {
    const query = `*[_type == "portfolio"] | order(_createdAt desc) {
      _id,
      title,
      category,
      slug,
      image {
        asset-> {
          _id,
          url
        }
      }
    }`;
    
    const result = await client.fetch(query);
    
    const sectionQuery = `*[_type == "homePage"][0]{
      portfolioSection {
        subtitle,
        title
      }
    }`;
    
    const sectionResult = await client.fetch(sectionQuery);
    
    if (sectionResult?.portfolioSection) {
      if (sectionResult.portfolioSection.subtitle) {
        subtitle = sectionResult.portfolioSection.subtitle;
      }
      if (sectionResult.portfolioSection.title) {
        title = sectionResult.portfolioSection.title;
      }
    }
    
    if (result && result.length > 0) {
      portfolioItems = result.map((item: any) => ({
        id: item._id,
        image: item.image?.asset?.url || '/assets/img/dental-project-1.jpg',
        category: item.category || 'Treatments',
        title: item.title || 'Dr. Name',
        link: `/portfolio/${item.slug?.current || 'details'}`,
      }));
    }
  } catch (error) {
    console.error('Error fetching portfolio data:', error);
  }
}

// Dark mode classes
const sectionClasses = darkMode 
  ? 'xl:py-120 lg:py-100 sm:py-80 py-60 section-portfolio dark-mode'
  : 'xl:py-120 lg:py-100 sm:py-80 py-60 section-portfolio';
---

<section class={sectionClasses}>
    <div class="container">
        <!-- Section Header -->
        <div class="flex items-end justify-between flex-wrap gap-4 xl:pb-50 lg:pb-40 pb-30"> 
            <div class="w-[fit-content]">
                <span class="capitalize font-semibold xxl:text-xxl xl:text-xl sm:text-lg text-base text-primary font-sora pb-6 block">{subtitle}</span>
                <h2 class="xl:text-5xl md:text-4xl sm:text-3xl text-2.5xl font-semibold text-secondary font-sora leading-[1.2]">{title}</h2> 
            </div>
            <a href="/portfolio" class="text-primary font-semibold font-sora hover:text-secondary transition-colors duration-300 flex items-center gap-2">
                View All <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>

        <!-- Portfolio Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-25">
            {portfolioItems.map((item) => (
                <div class="portfolio-card group relative rounded-2xl overflow-hidden" key={item.id}>
                    <div class="card-inner relative overflow-hidden rounded-2xl">
                        <!-- Image -->
                        <figure class="overflow-hidden">
                            <img 
                                src={item.image} 
                                alt={item.title} 
                                class="w-full h-[340px] object-cover transition-all duration-700 ease-out group-hover:scale-110" 
                                loading="lazy" 
                            />
                        </figure>
                        
                        {/* Gradient Overlay */}
                        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                        
                        {/* Top Badge */}
                        <div class="absolute top-4 left-4 opacity-0 group-hover:opacity-100 transition-all duration-500 delay-100">
                            <span class="inline-block bg-primary text-white text-xs font-bold uppercase tracking-wider px-4 py-2 rounded-full shadow-lg">
                                {item.category}
                            </span>
                        </div>

                        {/* Top Right Icon */}
                        <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-all duration-500 delay-200">
                            <a 
                                href={item.link} 
                                class="w-12 h-12 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center text-white hover:bg-primary hover:scale-110 transition-all duration-300 shadow-lg"
                            >
                                <i class="fa-solid fa-arrow-right text-lg"></i>
                            </a>
                        </div>
                        
                        {/* Bottom Content */}
                        <div class="absolute bottom-0 left-0 right-0 p-6 translate-y-8 group-hover:translate-y-0 opacity-0 group-hover:opacity-100 transition-all duration-500 ease-out">
                            <h3 class="text-white text-xl font-bold font-sora mb-2">
                                <a href={item.link} class="hover:text-primary transition-colors duration-300">
                                    {item.title}
                                </a>
                            </h3>
                            <div class="flex items-center justify-between">
                                <span class="text-white/80 text-sm font-medium">
                                    <i class="fa-regular fa-folder-open mr-2"></i>
                                    {item.category}
                                </span>
                                <a 
                                    href={item.link} 
                                    class="inline-flex items-center gap-2 text-white/80 hover:text-primary transition-colors duration-300 text-sm font-medium group/link"
                                >
                                    View Details
                                    <i class="fa-solid fa-arrow-right group-hover/link:translate-x-1 transition-transform duration-300"></i>
                                </a>
                            </div>
                        </div>

                        {/* Bottom Border Effect */}
                        <div class="absolute bottom-0 left-0 right-0 h-1 bg-primary scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
                    </div>
                </div>
            ))}
        </div>

        {/* Mobile View All Button */}
        <div class="text-center mt-12 block sm:hidden">
            <a href="/portfolio" class="btn">View All Portfolio <i class="fa-solid fa-arrow-right"></i></a>
        </div>
    </div>    
</section>

<style is:global>
/* ===== PORTFOLIO SECTION ===== */
.section-portfolio {
    position: relative;
    background: var(--color-offwhite);
    transition: background 0.3s ease;
}

/* Dark Mode */
.section-portfolio.dark-mode {
    background: var(--color-secondary);
}

.section-portfolio.dark-mode h2 {
    color: var(--color-white) !important;
}

.section-portfolio.dark-mode span:not(.text-primary) {
    color: var(--color-lightgary) !important;
}

/* ===== PORTFOLIO CARD - REDESIGNED ===== */
.portfolio-card {
    position: relative;
    border-radius: 16px;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.portfolio-card .card-inner {
    background: var(--color-white);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.portfolio-card:hover .card-inner {
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
    transform: translateY(-8px);
}

/* Image */
.portfolio-card figure {
    position: relative;
    overflow: hidden;
}

.portfolio-card figure img {
    transition: all 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    width: 100%;
    height: 340px;
    object-fit: cover;
}

.portfolio-card:hover figure img {
    transform: scale(1.1);
}

/* Gradient Overlay */
.portfolio-card .absolute.inset-0 {
    background: linear-gradient(to top, 
        rgba(0, 0, 0, 0.9) 0%, 
        rgba(0, 0, 0, 0.4) 50%, 
        transparent 100%
    );
}

/* Category Badge */
.portfolio-card .badge {
    background: var(--theme-colour);
    color: var(--color-white);
    padding: 6px 18px;
    border-radius: 50px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* Bottom Border Effect */
.portfolio-card .bottom-border {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--theme-colour);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.portfolio-card:hover .bottom-border {
    transform: scaleX(1);
}

/* Content Animations */
.portfolio-card .absolute.bottom-0 {
    transform: translateY(20px);
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.portfolio-card:hover .absolute.bottom-0 {
    transform: translateY(0);
    opacity: 1;
}

/* Icon Button */
.portfolio-card .top-right-icon {
    opacity: 0;
    transform: scale(0.8);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.portfolio-card:hover .top-right-icon {
    opacity: 1;
    transform: scale(1);
}

.portfolio-card .top-right-icon a {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    transition: all 0.3s ease;
}

.portfolio-card .top-right-icon a:hover {
    background: var(--theme-colour);
    transform: scale(1.1);
}

/* Top Left Badge */
.portfolio-card .top-left-badge {
    opacity: 0;
    transform: translateY(-10px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.portfolio-card:hover .top-left-badge {
    opacity: 1;
    transform: translateY(0);
}

/* ===== BUTTON ===== */
.btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 36px;
    border-radius: 50px;
    font-weight: 600;
    font-family: 'Sora', sans-serif;
    transition: all 0.4s ease;
    background: var(--theme-colour);
    color: var(--color-white);
    text-decoration: none;
    border: none;
    cursor: pointer;
}

.btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(166, 12, 19, 0.3);
    opacity: 0.9;
}

.btn span i {
    transition: transform 0.3s ease;
}

.btn:hover span i {
    transform: translateX(5px);
}

/* Dark Mode Button */
.dark-mode .btn {
    background: var(--theme-colour);
    color: var(--color-white);
}

/* ===== RESPONSIVE ===== */
@media (max-width: 1024px) {
    .portfolio-card figure img {
        height: 300px;
    }
}

@media (max-width: 768px) {
    .portfolio-card figure img {
        height: 280px;
    }
    
    .portfolio-card .absolute .p-6 {
        padding: 16px;
    }
    
    .portfolio-card h3 {
        font-size: 18px;
    }
}

@media (max-width: 640px) {
    .portfolio-card figure img {
        height: 300px;
    }
    
    .section-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
    }
}

@media (max-width: 480px) {
    .portfolio-card figure img {
        height: 260px;
    }
    
    .portfolio-card .absolute .p-6 {
        padding: 12px;
    }
    
    .portfolio-card h3 {
        font-size: 16px;
    }
}

/* Container */
.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 15px;
}
</style>