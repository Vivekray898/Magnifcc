---
// src/components/sections/services-details/ServicesDetailsHero.astro

import { client } from '../../../lib/sanity';

export interface Props {
  fetchFromSanity?: boolean;
  title?: string;
  subtitle?: string;
  image?: string;
}

const { 
  fetchFromSanity = true,
  title = "Services Details",
  subtitle = "Services Details",
  image = "/assets/img/bannr-img-6.png",
} = Astro.props;

let data = { title, subtitle, image };
let imageUrl = image;

// Fetch from Sanity
if (fetchFromSanity) {
  try {
    const query = `*[_type == "servicesDetailsPage"][0]{
      heroSection {
        title,
        subtitle,
        image {
          asset->{
            _id,
            url
          }
        }
      }
    }`;
    
    const result = await client.fetch(query);
    
    if (result?.heroSection) {
      data = { ...data, ...result.heroSection };
      
      if (result.heroSection.image?.asset?.url) {
        imageUrl = result.heroSection.image.asset.url;
      }
    }
  } catch (error) {
    console.error('Error fetching services details hero data:', error);
  }
}
---

<section class="pt-90 relative max-lg:bg-[right_center] bg-[#f4f4f4] bg-[url(../img/bannr-bg-img.png)] about-banner overflow-hidden">
  <div class="container">
    <div class="row items-center">
      <div class="lg:w-1/2 w-full">
        <div class="relative max-md:text-center">
          <h2 class="xxl:text-7.7xl xl:text-6.3xl md:text-5.2xl sm:text-4.75xl text-4.6xl font-bold capitalize font-sora text-secondary leading-[1.2]">{data.title}</h2>
        </div>
        <ol class="mb-16 flex items-center max-md:justify-center max-md:mb-40 pt-10">
          <li class="xxl:text-xxl md:text-xl text-sm text-secondary font-sora capitalize">
            <a href="/"> Home </a>
          </li>
          <li class="xxl:text-xxl md:text-xl text-sm text-gary capitalize before:content-['-'] before:float-left before:text-gary before:px-10" aria-current="page">
            {data.subtitle}
          </li>
        </ol>
      </div>
      <div class="lg:w-1/2 w-full">
        <div class="relative">
          <img 
            src={imageUrl} 
            alt="img" 
            class="w-[120%] xxl:max-w-[unset]"
            loading="lazy"
          >
        </div>
      </div>
    </div>
  </div>
</section>