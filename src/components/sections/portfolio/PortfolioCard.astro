---
// src/components/portfolio/PortfolioCard.astro
import type { PortfolioItem } from '../../../lib/sanity';

export interface Props {
  item: PortfolioItem;
}

const { item } = Astro.props;

const imageUrl = item.image?.asset?.url || '/assets/img/placeholder.jpg';
const category = item.category || 'Portfolio';
const title = item.title || 'Untitled';
const slug = item.slug?.current || item._id;
---

<div class="lg:col-span-4 md:col-span-6 col-span-12 group mt-20">
  <div class="relative mx-10 mb-20 portfolio-style"> 
    <figure class="overflow-hidden">
      <img 
        src={imageUrl} 
        alt={title} 
        class="group-hover:scale-[1.1] group-hover:rotate-[3deg] duration-500 w-full"
        loading="lazy"
      >
    </figure>
    <div class="absolute bottom-30 xxl:left-30 left-20 z-[2]">
      <span class="max-xxl:text-sm text-white leading-24 bg-[#ffffff26] py-10 px-15 inline-block rounded-tr-[10px] rounded-tl-[10px] pb-2 group-hover:text-secondary group-hover:bg-white duration-500">
        {category}
      </span>
      <h5>
        <a 
          href={`/portfolio/${slug}`} 
          class="xxl:text-xxl text-lg font-sora text-white xxl:leading-32 leading-28 bg-[#ffffff26] p-15 rounded-bl-[10px] rounded-br-[10px] rounded-tr-[10px] pt-3 font-bold pb-7 group-hover:text-secondary group-hover:bg-white duration-500"
        >
          {title}
        </a>
      </h5>
    </div> 
    <a 
      href={`/portfolio/${slug}`} 
      class="absolute -bottom-20 right-20 bg-secondary text-white size-65 rounded-full justify-center items-center flex border-5 border-white z-[11] group-hover:bg-primary duration-500"
      aria-label={`View ${title}`}
    >
      <i class="fa-solid fa-arrow-right"></i>
    </a>
  </div>
</div>