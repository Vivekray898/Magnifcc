---
// src/components/portfolio/Hero.astro
export interface Props {
  title?: string;
  subtitle?: string;
  backgroundImage?: string;
}

const { 
  title = 'Portfolio',
  subtitle = 'Our Work & Case Studies',
  backgroundImage = '/assets/img/bannr-bg-img.png'
} = Astro.props;
---

<section class="xl:pt-150 pt-100 relative max-lg:bg-[right_center] bg-[#f4f4f4] bg-[url('/assets/img/bannr-bg-img.png')] about-banner overflow-hidden">
  <div class="container">
    <div class="row items-center">
      <div class="lg:w-1/2 w-full">
        <div class="relative max-md:text-center">
          <h2 class="xxl:text-7.7xl xl:text-6.3xl md:text-5.2xl sm:text-4.75xl text-4.6xl font-bold capitalize font-sora text-secondary">
            {title}
          </h2>
          <img 
            src="/assets/img/shap-three-1.png" 
            alt="banner-shap" 
            class="absolute w-46 w-35 -top-15 -left-32 max-md:hidden animate-topshap"
          />
        </div>
        <ol class="mb-16 flex items-center max-md:justify-center max-md:mb-40">
          <li class="xxl:text-xxl md:text-xl text-sm text-secondary font-sora capitalize">
            <a href="/"> Home </a>
          </li>
          <li class="xxl:text-xxl md:text-xl text-sm text-gary capitalize before:content-['-'] before:float-left before:text-gary before:px-10" aria-current="page">
            {title.toLowerCase()}
          </li>
        </ol>
      </div>
      <div class="lg:w-1/2 w-full">
        <div>
          <img src="/assets/img/bannr-img.png" alt="img" class="w-[120%] xxl:max-w-[unset]" />
        </div>
      </div>
    </div>
  </div>
</section>