---
// src/components/portfolio/PortfolioGrid.astro
import type { PortfolioItem } from '../../../lib/sanity';
import PortfolioCard from './PortfolioCard.astro';

export interface Props {
  items: PortfolioItem[];
  currentPage?: number;
  totalPages?: number;
}

const { items = [], currentPage = 1, totalPages = 1 } = Astro.props;

const hasItems = items && items.length > 0;
---

<section class="lg:py-120 md:py-80 py-60">
  <div class="container">
    {hasItems ? (
      <>
        <div class="grid grid-cols-12 xxl:-mx-110 xl:-mx-80 md:-mx-40">
          {items.map((item) => (
            <PortfolioCard key={item._id} item={item} />
          ))}
        </div>
        
        <!-- Pagination -->
        {totalPages > 1 && (
          <ul class="flex items-center mt-40 pagination justify-center">
            {currentPage > 1 && (
              <li class="page-item ml-7">
                <a class="pag relativee-link page-link" href={`?page=${currentPage - 1}`} aria-label="Previous">
                  <span aria-hidden="true"><i class="fa-solid fa-arrow-left"></i></span>
                  <span class="sr-only">Previous</span>
                </a>
              </li>
            )}
            
            {Array.from({ length: Math.min(totalPages, 5) }, (_, i) => {
              let pageNum = i + 1;
              if (totalPages > 5) {
                if (currentPage > 3) {
                  pageNum = currentPage - 2 + i;
                  if (pageNum > totalPages) return null;
                }
                if (i === 0 && currentPage > 3) {
                  return (
                    <li class="page-item ml-7">
                      <span class="page-link relative">...</span>
                    </li>
                  );
                }
                if (i === 4 && pageNum < totalPages - 1) {
                  return (
                    <li class="page-item ml-7">
                      <span class="page-link relative">...</span>
                    </li>
                  );
                }
              }
              if (pageNum > totalPages) return null;
              return (
                <li class="page-item ml-7" key={i}>
                  <a 
                    class={`page-link relative ${pageNum === currentPage ? 'active' : ''}`} 
                    href={`?page=${pageNum}`}
                  >
                    {pageNum}
                  </a>
                </li>
              );
            })}
            
            {currentPage < totalPages && (
              <li class="page-item ml-7">
                <a class="page-link" href={`?page=${currentPage + 1}`} aria-label="Next">
                  <span aria-hidden="true"><i class="fa-solid fa-arrow-right"></i></span>
                  <span class="sr-only ml-7">Next</span>
                </a>
              </li>
            )}
          </ul>
        )}
      </>
    ) : (
      <div class="text-center py-40">
        <h3 class="text-2xl font-sora text-secondary">No portfolio items found</h3>
        <p class="text-gary mt-4">Check back later for our latest work.</p>
      </div>
    )}
  </div>
</section>

<style is:global>
  .page-link.active {
    background-color: #F05DA8;
    color: white;
    border-color: #F05DA8;
  }
  
  .page-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    border: 1px solid #e0e0e0;
    transition: all 0.3s ease;
    color: #021935;
  }
  
  .page-link:hover:not(.active) {
    background-color: #f5f5f5;
    border-color: #F05DA8;
  }
</style>