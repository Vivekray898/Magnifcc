---
// src/components/sections/About.astro

import { client } from '../../lib/sanity';

export interface Props {
  fetchFromSanity?: boolean;
  data?: {
    subtitle?: string;
    heading?: string;
    description?: string;
    image?: any;
    plusImage?: any;
    dotsImage?: any;
    featuresList?: string[];
  };
  darkMode?: boolean;
}

const { fetchFromSanity = true, data: propData, darkMode = false } = Astro.props;

// Default fallback data
const defaultData = {
  subtitle: '# Dental About Us',
  heading: 'Where Your Oral Health Comes First.',
  description: 'Health is our top priority. We are dedicated to providing personalized, high-quality dental care in a warm and welcoming environment. Whether you need preventive care, restorative treatments, or cosmetic enhancements.',
  image: null,
  plusImage: null,
  dotsImage: null,
  featuresList: [
    'Comprehensive Services',
    'Community Focused',
    'Modern Technology',
    'Trusted Legacy',
    'Commitment to Comfort',
    'Sustainability in Care'
  ],
};

let data = defaultData;
let imageUrl = '/assets/img/about-three.png';
let plusImageUrl = '/assets/img/plus.png';
let dotsImageUrl = '/assets/img/dots-img.png';

// Fetch from Sanity
if (fetchFromSanity && !propData) {
  try {
    const query = `*[_type == "homePage"][0]{
      aboutSection {
        subtitle,
        heading,
        description,
        image {
          asset->{
            _id,
            url
          }
        },
        plusImage {
          asset->{
            _id,
            url
          }
        },
        dotsImage {
          asset->{
            _id,
            url
          }
        },
        featuresList
      }
    }`;
    
    const result = await client.fetch(query);
    
    if (result?.aboutSection) {
      // Merge with defaults, ensuring featuresList is always an array
      const sectionData = result.aboutSection;
      data = {
        ...defaultData,
        ...sectionData,
        featuresList: sectionData.featuresList || defaultData.featuresList,
      };
      
      if (sectionData.image?.asset?.url) {
        imageUrl = sectionData.image.asset.url;
      }
      if (sectionData.plusImage?.asset?.url) {
        plusImageUrl = sectionData.plusImage.asset.url;
      }
      if (sectionData.dotsImage?.asset?.url) {
        dotsImageUrl = sectionData.dotsImage.asset.url;
      }
    }
  } catch (error) {
    console.error('Error fetching about data:', error);
  }
} else if (propData) {
  data = {
    ...defaultData,
    ...propData,
    featuresList: propData.featuresList || defaultData.featuresList,
  };
}

// Ensure featuresList is always an array
const featuresList = data.featuresList || defaultData.featuresList;

const {
  subtitle,
  heading,
  description,
} = data;

// Dark mode classes
const sectionClasses = darkMode 
  ? 'xl:pt-[120px] lg:pt-[100px] md:pt-[80px] pt-[60px] xl:pb-[120px] lg:pb-[100px] sm:pb-[80px] pb-[60px] relative section-about-two dark-mode'
  : 'xl:pt-[120px] lg:pt-[100px] md:pt-[80px] pt-[60px] xl:pb-[120px] lg:pb-[100px] sm:pb-[80px] pb-[60px] relative section-about-two';
---

<section class={sectionClasses}>
  <div class="container">
    <div class="grid grid-cols-12 gap-30">
      <!-- Content Column -->
      <div class="lg:col-span-6 col-span-12">
        <div class="pb-50 w-[fit-content]">
          <span class="pb-6 block font-sora font-semibold capitalize xxl:text-xxl xl:text-xl sm:text-lg leading-40" style="color: var(--theme-colour);">{subtitle}</span>
          <h2 class="xxl:text-5xl xl:text-4.65xl md:text-3.8xl sm:text-3xl text-2.5xl font-semibold font-sora leading-[1.2]" style="color: var(--common-colour);">{heading}</h2>
          <p class="mt-25 text-base font-normal xl:leading-30 leading-26" style="color: var(--color-gary);">{description}</p>
        </div>
        
        <!-- Features List - 2 columns -->
        <ul class="list-style w-full flex flex-wrap justify-between relative mb-40 before:content-[''] xl:before:left-[46%] before:left-1/2 before:absolute before:w-px before:h-full before:-translate-1/2 before:top-1/2" style="border-color: var(--color-lightgary);">
          {featuresList.map((feature, index) => (
            <li key={index} class="w-[45%] pb-21 font-semibold font-sora pl-20 relative max-xl:text-sm" style="color: var(--common-colour);">
              {feature}
            </li>
          ))}
        </ul>
        
        <a href="/about" class="btn max-xxl:px-30" style="background-color: var(--theme-colour); color: var(--color-white);">
          <span>More About Us<i class="fa-solid fa-arrow-right"></i></span>
        </a>
      </div>
      
      <!-- Image Column -->
      <div class="lg:col-span-6 col-span-12">
        <div class="relative">
          <img src={imageUrl} alt="About us" class="relative z-10 w-full rounded-2xl" loading="lazy" />
          {plusImageUrl && (
            <img src={plusImageUrl} alt="plus" class="plus absolute max-xxl:w-[60%] max-lg:w-[38%]" />
          )}
          {dotsImageUrl && (
            <img src={dotsImageUrl} alt="dots" class="dots-img animate-fa-spin absolute" />
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
/* About Section */
.section-about-two {
  position: relative;
  background: var(--color-offwhite);
  transition: background 0.3s ease, padding 0.3s ease;
}

/* Dark Mode */
.section-about-two.dark-mode {
  background: var(--color-secondary);
}

.section-about-two.dark-mode .list-style li {
  color: var(--color-white) !important;
}

.section-about-two.dark-mode .list-style li::before {
  background-color: var(--theme-colour);
}

.section-about-two.dark-mode h2 {
  color: var(--color-white) !important;
}

.section-about-two.dark-mode p {
  color: var(--color-lightgary) !important;
}

.section-about-two.dark-mode .list-style::before {
  background-color: var(--color-lightgary) !important;
}

/* Features List */
.list-style {
  position: relative;
}

.list-style li {
  position: relative;
  transition: color 0.3s ease;
}

.list-style li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8px;
  height: 8px;
  background-color: var(--theme-colour);
  border-radius: 50%;
  transition: background-color 0.3s ease;
}

/* Plus Image Position */
.plus {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 5;
  opacity: 0.15;
  pointer-events: none;
}

/* Dots Image Position */
.dots-img {
  position: absolute;
  bottom: -20px;
  right: -20px;
  z-index: 5;
  max-width: 80px;
  opacity: 0.6;
  pointer-events: none;
}

/* Animation */
@keyframes fa-spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.animate-fa-spin {
  animation: fa-spin 20s linear infinite;
}

/* Button */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 36px;
  border-radius: 50px;
  font-weight: 600;
  font-family: 'Sora', sans-serif;
  transition: all 0.4s ease;
  border: none;
  cursor: pointer;
  text-decoration: none;
}

.btn:hover {
  opacity: 0.85;
  transform: translateY(-2px);
  box-shadow: 0 10px 30px rgba(166, 12, 19, 0.3);
}

.btn span i {
  transition: transform 0.3s ease;
  margin-left: 8px;
}

.btn:hover span i {
  transform: translateX(5px);
}

.btn.max-xxl\:px-30 {
  padding-left: 30px;
  padding-right: 30px;
}

/* Container */
.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 15px;
}

/* Responsive */
@media (max-width: 1024px) {
  .list-style {
    gap: 8px 0;
  }
  
  .list-style li {
    width: 48%;
    font-size: 14px;
    padding-bottom: 14px;
  }
}

@media (max-width: 768px) {
  .list-style li {
    width: 100%;
    padding-bottom: 12px;
  }
  
  .plus {
    max-width: 60%;
  }
  
  .dots-img {
    max-width: 50px;
    bottom: -10px;
    right: -10px;
  }
}

@media (max-width: 480px) {
  .list-style li {
    font-size: 13px;
    padding-bottom: 10px;
  }
  
  .btn {
    padding: 12px 24px;
    font-size: 14px;
  }
}
</style>