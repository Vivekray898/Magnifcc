---
// src/components/sections/Marquee.astro

import { client } from '../../lib/sanity';
import { imageUrlFor } from '../../lib/sanity-image';

export interface Props {
  variant?: 'primary' | 'secondary';
  className?: string;
  fetchFromSanity?: boolean;
}

const { variant = 'primary', className = '', fetchFromSanity = true } = Astro.props;

// Default items - updated to match the image
const defaultItems = [
  { icon: 'health-img-3.png', text: 'Hospital Planning' },
  { icon: 'health-img-3.png', text: 'NABH & NABL' },
  { icon: 'health-img-3.png', text: 'Public Health' },
  { icon: 'health-img-3.png', text: 'RelyHMIS' },
  { icon: 'health-img-3.png', text: 'Equipment Support' },
  { icon: 'health-img-3.png', text: 'Management Consulting' },
];

let items = defaultItems;
const imageBase = '/assets/img/';

// Fetch from Sanity
if (fetchFromSanity) {
  try {
    const query = `*[_type == "homePage"][0]{
      marqueeItems {
        items[] {
          text,
          icon {
            asset->{
              _id,
              url
            }
          }
        }
      }
    }`;
    
    const result = await client.fetch(query);
    
    if (result?.marqueeItems?.items?.length > 0) {
      items = result.marqueeItems.items.map((item: any) => ({
        text: item.text || '',
        icon: item.icon?.asset?.url || 'health-img-3.png',
      }));
    }
  } catch (error) {
    console.error('Error fetching marquee data:', error);
  }
}

// Determine which marquee style to render
const isPrimary = variant === 'primary';
const isSecondary = variant === 'secondary';
---

<!-- Primary Marquee -->
{
  isPrimary && (
    <div class={`flex overflow-hidden relative z-[11] ${className}`}>
      <div class="py-20 bg-primary flex w-full">
        <div class="animate-scroll-one flex items-center" style="gap: 30px;">
          {items.map((item, index) => (
            <div key={`primary-1-${index}`} class="flex-shrink-0 flex items-center" style={{ gap: '20px' }}>
              <img 
                src={item.icon.startsWith('http') ? item.icon : `${imageBase}${item.icon}`}
                alt={item.text} 
                class="max-xxl:w-60 max-lg:w-36"
                loading="lazy"
              />
              <h3 class="xxl:text-5.2xl lg:text-4.65xl text-3xl uppercase font-bold text-white font-sora whitespace-nowrap" 
                  style={{ whiteSpace: 'nowrap', display: 'inline-block' }}>
                {item.text}
              </h3>
            </div>
          ))}
        </div>
        <div class="animate-scroll-one flex items-center" style={{ gap: '30px', marginLeft: '30px' }}>
          {items.map((item, index) => (
            <div key={`primary-2-${index}`} class="flex-shrink-0 flex items-center" style={{ gap: '20px' }}>
              <img 
                src={item.icon.startsWith('http') ? item.icon : `${imageBase}${item.icon}`}
                alt={item.text} 
                class="max-xxl:w-60 max-lg:w-36"
                loading="lazy"
              />
              <h3 class="xxl:text-5.2xl lg:text-4.65xl text-3xl uppercase font-bold text-white font-sora whitespace-nowrap"
                  style={{ whiteSpace: 'nowrap', display: 'inline-block' }}>
                {item.text}
              </h3>
            </div>
          ))}
        </div>
      </div>
    </div>
  )
}

<!-- Secondary Marquee - with adjusted spacing -->
{
  isSecondary && (
    <div class={`gap-30 flex items-center z-[1] md:pb-120 pb-70 overflow-hidden relative ${className}`}>
      <div class="flex bg-secondary py-20 rotate-[357deg] w-full">
        <div class="animate-scroll-two flex items-center" style={{ gap: '30px' }}>
          {items.map((item, index) => (
            <div key={`secondary-1-${index}`} class="flex-shrink-0 flex items-center" style={{ gap: '20px' }}>
              <img 
                src={item.icon.startsWith('http') ? item.icon : `${imageBase}${item.icon}`}
                alt={item.text} 
                class="max-xxl:w-60 max-lg:w-36"
                loading="lazy"
              />
              <h3 class="xxl:text-5.2xl lg:text-4.65xl text-3xl uppercase font-bold text-white font-sora whitespace-nowrap"
                  style={{ whiteSpace: 'nowrap', display: 'inline-block' }}>
                {item.text}
              </h3>
            </div>
          ))}
        </div>
        <div class="animate-scroll-two flex items-center" style={{ gap: '30px', marginLeft: '30px' }}>
          {items.map((item, index) => (
            <div key={`secondary-2-${index}`} class="flex-shrink-0 flex items-center" style={{ gap: '20px' }}>
              <img 
                src={item.icon.startsWith('http') ? item.icon : `${imageBase}${item.icon}`}
                alt={item.text} 
                class="max-xxl:w-60 max-lg:w-36"
                loading="lazy"
              />
              <h3 class="xxl:text-5.2xl lg:text-4.65xl text-3xl uppercase font-bold text-white font-sora whitespace-nowrap"
                  style={{ whiteSpace: 'nowrap', display: 'inline-block' }}>
                {item.text}
              </h3>
            </div>
          ))}
        </div>
      </div>
    </div>
  )
}

<style>
  /* Animation keyframes - exact match to HTML */
  .animate-scroll-one {
    animation: scroll-left 40s linear infinite;
  }

  .animate-scroll-two {
    animation: scroll-right 40s linear infinite;
  }

  @keyframes scroll-left {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-100%);
    }
  }

  @keyframes scroll-right {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-100%);
    }
  }

  /* Hover pause effect - matches the HTML style */
  .animate-scroll-one:hover,
  .animate-scroll-two:hover {
    animation-play-state: paused;
  }

  /* Prevent overflow and ensure proper spacing */
  .flex-shrink-0 {
    flex-shrink: 0;
  }

  /* Fix for secondary marquee rotation */
  .rotate-\[357deg\] {
    transform: rotate(357deg);
  }
</style>