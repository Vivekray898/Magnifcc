---
// src/components/sections/Marquee.astro

import { client } from '../../lib/sanity';
import { imageUrlFor } from '../../lib/sanity-image';

export interface Props {
  variant?: 'primary' | 'secondary';
  className?: string;
  fetchFromSanity?: boolean;
  speed?: 'slow' | 'normal' | 'fast';
}

const { 
  variant = 'primary', 
  className = '', 
  fetchFromSanity = true,
  speed = 'normal'
} = Astro.props;

// Default items - updated to match the image
const defaultItems = [
  { icon: 'health-img-3.png', text: 'Hospital Planning' },
  { icon: 'health-img-3.png', text: 'NABH & NABL' },
  { icon: 'health-img-3.png', text: 'Public Health' },
  { icon: 'health-img-3.png', text: 'RelyHMIS' },
  { icon: 'health-img-3.png', text: 'Equipment Support' },
  { icon: 'health-img-3.png', text: 'Management Consulting' },
];

let items = defaultItems;
const imageBase = '/assets/img/';

// Fetch from Sanity
if (fetchFromSanity) {
  try {
    const query = `*[_type == "homePage"][0]{
      marqueeItems {
        items[] {
          text,
          icon {
            asset->{
              _id,
              url
            }
          }
        }
      }
    }`;
    
    const result = await client.fetch(query);
    
    if (result?.marqueeItems?.items?.length > 0) {
      items = result.marqueeItems.items.map((item: any) => ({
        text: item.text || '',
        icon: item.icon?.asset?.url || 'health-img-3.png',
      }));
    }
  } catch (error) {
    console.error('Error fetching marquee data:', error);
  }
}

// Determine which marquee style to render
const isPrimary = variant === 'primary';
const isSecondary = variant === 'secondary';

// Animation duration based on speed
const speedMap = {
  slow: '40s',
  normal: '25s',
  fast: '15s'
};
const animationDuration = speedMap[speed] || speedMap.normal;
---

<!-- Primary Marquee -->
{
  isPrimary && (
    <div class={`marquee-wrapper ${className}`}>
      <div class="marquee-track marquee-primary">
        <div class="marquee-content" style={`animation-duration: ${animationDuration}`}>
          {items.map((item, index) => (
            <div key={`primary-1-${index}`} class="marquee-item">
              <img 
                src={item.icon.startsWith('http') ? item.icon : `${imageBase}${item.icon}`}
                alt={item.text} 
                class="marquee-icon"
                loading="lazy"
              />
              <span class="marquee-text">{item.text}</span>
              <span class="marquee-separator">&bull;</span>
            </div>
          ))}
        </div>
        <div class="marquee-content marquee-content-duplicate" style={`animation-duration: ${animationDuration}`} aria-hidden="true">
          {items.map((item, index) => (
            <div key={`primary-2-${index}`} class="marquee-item">
              <img 
                src={item.icon.startsWith('http') ? item.icon : `${imageBase}${item.icon}`}
                alt="" 
                class="marquee-icon"
                loading="lazy"
              />
              <span class="marquee-text">{item.text}</span>
              <span class="marquee-separator">&bull;</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  )
}

<!-- Secondary Marquee - rotated strip -->
{
  isSecondary && (
    <div class={`marquee-wrapper marquee-secondary-wrapper ${className}`}>
      <div class="marquee-track marquee-secondary">
        <div class="marquee-content marquee-reverse" style={`animation-duration: ${animationDuration}`}>
          {items.map((item, index) => (
            <div key={`secondary-1-${index}`} class="marquee-item">
              <img 
                src={item.icon.startsWith('http') ? item.icon : `${imageBase}${item.icon}`}
                alt={item.text} 
                class="marquee-icon"
                loading="lazy"
              />
              <span class="marquee-text">{item.text}</span>
              <span class="marquee-separator">&bull;</span>
            </div>
          ))}
        </div>
        <div class="marquee-content marquee-content-duplicate marquee-reverse" style={`animation-duration: ${animationDuration}`} aria-hidden="true">
          {items.map((item, index) => (
            <div key={`secondary-2-${index}`} class="marquee-item">
              <img 
                src={item.icon.startsWith('http') ? item.icon : `${imageBase}${item.icon}`}
                alt="" 
                class="marquee-icon"
                loading="lazy"
              />
              <span class="marquee-text">{item.text}</span>
              <span class="marquee-separator">&bull;</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  )
}

<style>
  /* Marquee Container */
  .marquee-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    z-index: 11;
  }

  .marquee-secondary-wrapper {
    padding: 30px 0;
    z-index: 1;
  }

  /* Marquee Track - the scrolling container */
  .marquee-track {
    display: flex;
    width: 100%;
    position: relative;
  }

  .marquee-primary {
    background: var(--color-primary, #a60c13);
    padding: 16px 0;
  }

  .marquee-secondary {
    background: var(--color-secondary, #1a1a1a);
    padding: 16px 0;
    transform: rotate(-3deg);
    width: 112%;
    margin-left: -6%;
  }

  /* Marquee Content - the actual scrolling content */
  .marquee-content {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 48px;
    animation: marquee-scroll-left 25s linear infinite;
    will-change: transform;
  }

  .marquee-content-duplicate {
    margin-left: 48px;
  }

  .marquee-reverse {
    animation-name: marquee-scroll-right;
  }

  /* Pause on hover */
  .marquee-track:hover .marquee-content {
    animation-play-state: paused;
  }

  /* Individual Item */
  .marquee-item {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
    white-space: nowrap;
  }

  /* Icon */
  .marquee-icon {
    width: 32px;
    height: 32px;
    object-fit: contain;
    opacity: 0.9;
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .marquee-icon {
      width: 40px;
      height: 40px;
    }
  }

  /* Text */
  .marquee-text {
    font-family: 'Sora', sans-serif;
    font-size: 20px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: white;
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .marquee-text {
      font-size: 23px;
    }
  }

  @media (min-width: 1280px) {
    .marquee-text {
      font-size: 25px;
    }
  }

  /* Separator */
  .marquee-separator {
    color: rgba(255, 255, 255, 0.3);
    font-size: 18px;
    flex-shrink: 0;
  }

  /* Keyframe Animations */
  @keyframes marquee-scroll-left {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-100%);
    }
  }

  @keyframes marquee-scroll-right {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(0);
    }
  }

  /* Fade edges */
  .marquee-wrapper::before,
  .marquee-wrapper::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 80px;
    z-index: 2;
    pointer-events: none;
  }

  .marquee-wrapper::before {
    left: 0;
    background: linear-gradient(90deg, 
      var(--color-offwhite, #f7f5f0) 0%, 
      transparent 100%
    );
  }

  .marquee-wrapper::after {
    right: 0;
    background: linear-gradient(270deg, 
      var(--color-offwhite, #f7f5f0) 0%, 
      transparent 100%
    );
  }

  .marquee-secondary-wrapper::before {
    background: linear-gradient(90deg, 
      var(--color-offwhite, #f7f5f0) 0%, 
      transparent 100%
    );
  }

  .marquee-secondary-wrapper::after {
    background: linear-gradient(270deg, 
      var(--color-offwhite, #f7f5f0) 0%, 
      transparent 100%
    );
  }

  /* Accessibility: Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>