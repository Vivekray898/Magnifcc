---
// src/components/sections/Marquee.astro

import { client } from '../../lib/sanity';
import { imageUrlFor } from '../../lib/sanity-image';

export interface Props {
  variant?: 'primary' | 'secondary';
  className?: string;
  fetchFromSanity?: boolean;
}

const { variant = 'primary', className = '', fetchFromSanity = true } = Astro.props;

// Default items - updated to match the image
const defaultItems = [
  { icon: 'health-img-3.png', text: 'Hospital Planning' },
  { icon: 'health-img-3.png', text: 'NABH & NABL' },
  { icon: 'health-img-3.png', text: 'Public Health' },
  { icon: 'health-img-3.png', text: 'RelyHMIS' },
  { icon: 'health-img-3.png', text: 'Equipment Support' },
  { icon: 'health-img-3.png', text: 'Management Consulting' },
];

let items = defaultItems;
const imageBase = '/assets/img/';

// Fetch from Sanity
if (fetchFromSanity) {
  try {
    const query = `*[_type == "homePage"][0]{
      marqueeItems {
        items[] {
          text,
          icon {
            asset->{
              _id,
              url
            }
          }
        }
      }
    }`;
    
    const result = await client.fetch(query);
    
    if (result?.marqueeItems?.items?.length > 0) {
      items = result.marqueeItems.items.map((item: any) => ({
        text: item.text || '',
        icon: item.icon?.asset?.url || 'health-img-3.png',
      }));
    }
  } catch (error) {
    console.error('Error fetching marquee data:', error);
  }
}

// Determine which marquee style to render
const isPrimary = variant === 'primary';
const isSecondary = variant === 'secondary';
---

<!-- Primary Marquee -->
{
  isPrimary && (
    <div class={`marquee-mask flex overflow-hidden relative z-[11] ${className}`}>
      <div class="py-16 bg-primary flex w-full">
        <div class="animate-scroll-one flex items-center" style="gap: 26px;">
          {items.map((item, index) => (
            <div key={`primary-1-${index}`} class="flex-shrink-0 flex items-center" style={{ gap: '16px' }}>
              <img 
                src={item.icon.startsWith('http') ? item.icon : `${imageBase}${item.icon}`}
                alt={item.text} 
                class="w-32 md:w-40 opacity-90"
                loading="lazy"
              />
              <h3 class="text-xl md:text-2.3xl xl:text-2.5xl uppercase font-semibold tracking-[0.02em] text-white font-sora whitespace-nowrap">
                {item.text}
              </h3>
              <span class="text-white/30 text-lg">&bull;</span>
            </div>
          ))}
        </div>
        <div class="animate-scroll-one flex items-center" style={{ gap: '26px', marginLeft: '26px' }} aria-hidden="true">
          {items.map((item, index) => (
            <div key={`primary-2-${index}`} class="flex-shrink-0 flex items-center" style={{ gap: '16px' }}>
              <img 
                src={item.icon.startsWith('http') ? item.icon : `${imageBase}${item.icon}`}
                alt="" 
                class="w-32 md:w-40 opacity-90"
                loading="lazy"
              />
              <h3 class="text-xl md:text-2.3xl xl:text-2.5xl uppercase font-semibold tracking-[0.02em] text-white font-sora whitespace-nowrap">
                {item.text}
              </h3>
              <span class="text-white/30 text-lg">&bull;</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  )
}

<!-- Secondary Marquee - rotated strip, width overshoots the container so the tilt never reveals the background behind it -->
{
  isSecondary && (
    <div class={`gap-30 flex items-center z-[1] md:pb-120 pb-70 overflow-hidden relative ${className}`}>
      <div class="marquee-mask flex bg-secondary py-16 rotate-[-3deg] w-[112%] -ml-[6%]">
        <div class="animate-scroll-two flex items-center" style={{ gap: '26px' }}>
          {items.map((item, index) => (
            <div key={`secondary-1-${index}`} class="flex-shrink-0 flex items-center" style={{ gap: '16px' }}>
              <img 
                src={item.icon.startsWith('http') ? item.icon : `${imageBase}${item.icon}`}
                alt={item.text} 
                class="w-32 md:w-40 opacity-90"
                loading="lazy"
              />
              <h3 class="text-xl md:text-2.3xl xl:text-2.5xl uppercase font-semibold tracking-[0.02em] text-white font-sora whitespace-nowrap">
                {item.text}
              </h3>
              <span class="text-white/30 text-lg">&bull;</span>
            </div>
          ))}
        </div>
        <div class="animate-scroll-two flex items-center" style={{ gap: '26px', marginLeft: '26px' }} aria-hidden="true">
          {items.map((item, index) => (
            <div key={`secondary-2-${index}`} class="flex-shrink-0 flex items-center" style={{ gap: '16px' }}>
              <img 
                src={item.icon.startsWith('http') ? item.icon : `${imageBase}${item.icon}`}
                alt="" 
                class="w-32 md:w-40 opacity-90"
                loading="lazy"
              />
              <h3 class="text-xl md:text-2.3xl xl:text-2.5xl uppercase font-semibold tracking-[0.02em] text-white font-sora whitespace-nowrap">
                {item.text}
              </h3>
              <span class="text-white/30 text-lg">&bull;</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  )
}

<style>
  /*
    No local animation/keyframe overrides here on purpose — animate-scroll-one and
    animate-scroll-two are already defined once, correctly, in the global theme
    (scroll-one moves left, scroll-two moves right). Redefining them locally was
    what broke the alternating-direction effect; removed rather than duplicated.
  */

  .animate-scroll-one:hover,
  .animate-scroll-two:hover {
    animation-play-state: paused;
  }

  /* Fade the marquee out at both edges instead of a hard visual cut */
  .marquee-mask {
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 5%, #000 95%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 5%, #000 95%, transparent 100%);
  }
</style>