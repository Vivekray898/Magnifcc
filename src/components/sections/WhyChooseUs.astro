---
// src/components/sections/WhyChooseUs.astro

import { client } from '../../lib/sanity';

export interface Props {
    fetchFromSanity?: boolean;
    title?: string;
    subtitle?: string;
    description?: string;
    image?: string;
    features?: Array<{
        iconBg: string;
        iconShadow: string;
        icon: string;
        title: string;
        description: string;
    }>;
}

const { fetchFromSanity = true } = Astro.props;

// Default values - consultancy focused
const defaultTitle = "Why Choose Our Consultancy";
const defaultSubtitle = "Why Choose Us";
const defaultDescription = "We deliver strategic insights and data-driven solutions that transform healthcare organizations. Our consultancy approach combines deep industry expertise with innovative thinking to drive measurable results.";
const defaultImage = "assets/img/choose-us.jpg";
const defaultFeatures = [
    {
        iconBg: "#a60c13",
        iconShadow: "rgba(166,12,19,0.4)",
        icon: "fa-solid fa-chart-line",
        title: "Strategic Advisory",
        description: "We provide expert guidance to help you navigate complex healthcare challenges and achieve sustainable growth."
    },
    {
        iconBg: "#a60c13",
        iconShadow: "rgba(166,12,19,0.4)",
        icon: "fa-solid fa-people-group",
        title: "Expert Team",
        description: "Our consultants bring decades of combined experience in healthcare management, operations, and strategy."
    },
    {
        iconBg: "#a60c13",
        iconShadow: "rgba(166,12,19,0.4)",
        icon: "fa-solid fa-lightbulb",
        title: "Innovation Focus",
        description: "We leverage cutting-edge research and emerging technologies to deliver forward-thinking solutions."
    },
    {
        iconBg: "#a60c13",
        iconShadow: "rgba(166,12,19,0.4)",
        icon: "fa-solid fa-handshake",
        title: "Partnership Approach",
        description: "We collaborate closely with your team to ensure alignment and shared success throughout the engagement."
    }
];

let title = defaultTitle;
let subtitle = defaultSubtitle;
let description = defaultDescription;
let image = defaultImage;
let features = defaultFeatures;

// Fetch from Sanity
if (fetchFromSanity) {
  try {
    const query = `*[_type == "homePage"][0]{
      whyChooseUs {
        subtitle,
        title,
        description,
        image {
          asset->{
            _id,
            url
          }
        },
        features[] {
          title,
          description,
          iconBgColor,
          icon
        }
      }
    }`;
    
    const result = await client.fetch(query);
    
    if (result?.whyChooseUs) {
      // Update text fields
      if (result.whyChooseUs.subtitle) subtitle = result.whyChooseUs.subtitle;
      if (result.whyChooseUs.title) title = result.whyChooseUs.title;
      if (result.whyChooseUs.description) description = result.whyChooseUs.description;
      
      // Update images
      if (result.whyChooseUs.image?.asset?.url) {
        image = result.whyChooseUs.image.asset.url;
      }
      
      // Update features
      if (result.whyChooseUs.features?.length > 0) {
        features = result.whyChooseUs.features.map((feature: any) => {
          const color = feature.iconBgColor || '#a60c13';
          return {
            iconBg: color,
            iconShadow: color,
            icon: feature.icon || 'fa-solid fa-circle-check',
            title: feature.title || 'Feature',
            description: feature.description || '',
          };
        });
      }
    }
  } catch (error) {
    console.error('Error fetching why choose us data:', error);
    // Keep using default data
  }
}
---

<section class="bg-[#f8f6f5] pt-60 md:pt-80 xxl:pt-80 xxl:pb-90 lg:pb-90 md:pb-80 pb-60">
    <div class="container">
        <div class="grid grid-cols-12 gap-30 lg:items-stretch">

            <!-- Mobile: Header Content (shown on mobile, hidden on desktop) -->
            <div class="col-span-12 lg:hidden pb-8">
                <div class="flex items-center gap-10 mb-10">
                    <span class="w-24 h-[2px] bg-primary"></span>
                    <span class="font-montserrat text-[11px] font-bold uppercase tracking-[0.18em] text-primary">{subtitle}</span>
                </div>
                <h2 class="xl:text-4.6xl md:text-4xl sm:text-3xl text-2.5xl font-semibold text-secondary font-sora leading-[1.2]">{title}</h2>
            </div>

            <!-- Left Column - Image -->
            <div class="lg:col-span-5 col-span-12 lg:order-1 order-2">
                <div class="relative h-[360px] sm:h-[440px] lg:h-full lg:min-h-[520px]">
                    <figure class="relative h-full rounded-2xl overflow-hidden border border-secondary/10 shadow-[0_30px_70px_-25px_rgba(2,25,53,0.3)]">
                        {image && (
                            <img src={image} alt={title} class="w-full h-full object-cover" loading="lazy" />
                        )}
                        <div class="absolute inset-0 bg-gradient-to-t from-secondary/70 via-secondary/0 to-transparent"></div>
                    </figure>

                    <!-- Open corner mark -->
                    <span class="hidden lg:block absolute -top-12 -right-12 w-44 h-44 border-t-2 border-r-2 border-primary"></span>
                </div>
            </div>

            <!-- Right Column - Content -->
            <div class="lg:col-span-7 col-span-12 flex flex-col lg:justify-center lg:order-2 order-3">
                <!-- Desktop: Header Content (hidden on mobile, shown on desktop) -->
                <div class="hidden lg:block pb-8">
                    <div class="flex items-center gap-10 mb-10">
                        <span class="w-24 h-[2px] bg-primary"></span>
                        <span class="font-montserrat text-[11px] font-bold uppercase tracking-[0.18em] text-primary">{subtitle}</span>
                    </div>
                    <h2 class="xl:text-4.6xl md:text-4xl sm:text-3xl text-2.5xl font-semibold text-secondary font-sora leading-[1.2]">{title}</h2>
                </div>

                <div class="pb-0">
                    <p class="text-base leading-28 text-gary font-normal border-l-2 border-primary/60 pl-24 mt-0 lg:mt-24">{description}</p>
                </div>

                <div class="grid sm:grid-cols-2 grid-cols-1 gap-20 mt-8 lg:mt-0">
                    {features.map((feature, index) => (
                        <div class="group flex items-start gap-16 p-20 bg-white rounded-xl border border-secondary/10 hover:border-primary/30 hover:shadow-[0_20px_40px_-24px_rgba(2,25,53,0.25)] duration-500" key={index}>
                            <div 
                                class="size-52 shrink-0 flex items-center justify-center rounded-full transition-transform duration-500 group-hover:scale-105 text-white text-2xl"
                                style={{
                                    backgroundColor: feature.iconBg,
                                    boxShadow: `${feature.iconShadow} 0px 0px 18px 0px`
                                }}
                            >
                                <i class={feature.icon}></i>
                            </div>
                            <div class="min-w-0">
                                <h4 class="font-bold text-lg pb-4 text-secondary leading-[1.2] font-sora">{feature.title}</h4>
                                <p class="text-sm leading-24 text-gary font-normal">{feature.description}</p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</section>