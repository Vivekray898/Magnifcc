---
// src/components/sections/WhyChooseUs.astro

import { client } from '../../lib/sanity';

export interface Props {
    fetchFromSanity?: boolean;
    title?: string;
    subtitle?: string;
    description?: string;
    image?: string;
    logoImage?: string;
    circleImage?: string;
    features?: Array<{
        iconBg: string;
        iconShadow: string;
        svg: string;
        title: string;
        description: string;
    }>;
}

const { fetchFromSanity = true } = Astro.props;

// Default values
const defaultTitle = "Where Compassion Meets Expertise.";
const defaultSubtitle = "Why Choose Us";
const defaultDescription = "We believe healthcare is not just about treating illnesses—it's about caring for people. With a perfect balance of compassion and expertise, our team is dedicated to providing exceptional medical care while ensuring every patient.";
const defaultImage = "assets/img/choose-us.jpg";
const defaultLogoImage = "assets/img/choose-us-logo.png";
const defaultCircleImage = "assets/img/circle-image.png";
const defaultFeatures = [
    {
        iconBg: "bg-[#F05DA8]",
        iconShadow: "shadow-[#f05da866_0px_0px_18px_0px]",
        svg: `<svg class="size-30" width="45" height="49" viewBox="0 0 45 49" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M33.762 18.3703C33.762 18.0993 33.6541 17.8395 33.4621 17.6479C33.2701 17.4563 33.0097 17.3486 32.7381 17.3486H27.6191V12.2402C27.6191 11.9693 27.5112 11.7094 27.3192 11.5178C27.1272 11.3262 26.8668 11.2185 26.5953 11.2185H18.4048C18.1333 11.2185 17.8729 11.3262 17.6809 11.5178C17.4889 11.7094 17.381 11.9693 17.381 12.2402V17.3486H12.2619C11.9904 17.3486 11.73 17.4563 11.538 17.6479C11.346 17.8395 11.2381 18.0993 11.2381 18.3703V26.5437C11.2381 26.8147 11.346 27.0746 11.538 27.2662C11.73 27.4578 11.9904 27.5654 12.2619 27.5654H17.381V32.6738C17.381 32.9448 17.4889 33.2047 17.6809 33.3963C17.8729 33.5879 18.1333 33.6955 18.4048 33.6955H26.5953C26.8668 33.6955 27.1272 33.5879 27.3192 33.3963C27.5112 33.2047 27.6191 32.9448 27.6191 32.6738V27.5654H32.7381C33.0097 27.5654 33.2701 27.4578 33.4621 27.2662C33.6541 27.0746 33.762 26.8147 33.762 26.5437V18.3703Z" stroke="white" stroke-linecap="round" stroke-linejoin="round"/><path d="M1 7.69417V23.2993C1.06016 28.4557 2.70685 33.4691 5.71707 37.6605C8.72728 41.8519 12.9556 45.0189 17.8294 46.7326L20.1248 47.5785C21.6582 48.1405 23.3418 48.1405 24.8752 47.5785L27.1706 46.7326C32.0444 45.0189 36.2727 41.8519 39.2829 37.6605C42.2932 33.4691 43.9398 28.4557 44 23.2993V7.69417C43.9979 7.08107 43.8156 6.48205 43.4757 5.97136C43.1357 5.46067 42.6531 5.06076 42.0875 4.82121C35.8846 2.23873 29.2209 0.939488 22.5 1.00216C15.7791 0.939488 9.11545 2.23873 2.91248 4.82121C2.34694 5.06076 1.86428 5.46067 1.52432 5.97136C1.18436 6.48205 1.00206 7.08107 1 7.69417Z" stroke="white" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
        title: "Expert Professionals",
        description: "Our highly skilled doctors, nurses, and specialists bring years of experience and a commitment to excellence in every service we provide."
    },
    {
        iconBg: "bg-[#58CBF2]",
        iconShadow: "shadow-[#58cbf266_0px_0px_18px_0px]",
        svg: `<svg class="size-30" width="49" height="49" viewBox="0 0 49 49" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M14.1661 36.9778C15.9035 36.3659 17.5836 35.6021 19.1869 34.6952M43.629 45.9939L42.7544 47.8331L32.2999 41.1938C31.3479 40.5881 30.6499 39.6555 30.3372 38.5713C30.0245 37.4871 30.1186 36.3261 30.6018 35.3064C31.0843 34.2865 31.9227 33.478 32.9595 33.0328C33.9962 32.5877 35.1598 32.5365 36.2316 32.889L48 36.7594L47.1254 38.5985M26.523 29.7911C31.9403 25.6919 40.8478 17.9388 40.8478 11.2811C40.8478 0.0745119 26.7846 -2.98257 22.4565 7.2043C18.1284 -2.98257 4.0652 0.0745119 4.0652 11.2811C4.0652 20.8467 21.7066 32.1841 22.4565 32.6745C24.8617 34.248 29.3185 36.1485 30.4731 35.6049M1 40.8477C1 42.7446 1.75353 44.5638 3.09483 45.9052C4.43612 47.2465 6.25531 48 8.15218 48C10.0491 48 11.8682 47.2465 13.2095 45.9052C14.5508 44.5638 15.3044 42.7446 15.3044 40.8477C15.3044 38.9508 14.5508 37.1316 13.2095 35.7903C11.8682 34.449 10.0491 33.6955 8.15218 33.6955C6.25531 33.6955 4.43612 34.449 3.09483 35.7903C1.75353 37.1316 1 38.9508 1 40.8477ZM6.10864 40.848C6.10864 41.39 6.32394 41.9097 6.70716 42.293C7.09039 42.6762 7.61016 42.8915 8.15212 42.8915C8.69409 42.8915 9.21385 42.6762 9.59708 42.293C9.98031 41.9097 10.1956 41.39 10.1956 40.848C10.1956 40.306 9.98031 39.7862 9.59708 39.403C9.21385 39.0198 8.69409 38.8045 8.15212 38.8045C7.61016 38.8045 7.09039 39.0198 6.70716 39.403C6.32394 39.7862 6.10864 40.306 6.10864 40.848Z" stroke="white" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
        title: "Beyond Treatments",
        description: "Our highly skilled doctors, nurses, and specialists bring years of experience and a commitment to excellence in every service we provide."
    }
];

let title = defaultTitle;
let subtitle = defaultSubtitle;
let description = defaultDescription;
let image = defaultImage;
let logoImage = defaultLogoImage;
let circleImage = defaultCircleImage;
let features = defaultFeatures;
let badgeText = "Accredited healthcare advisory practice";

// Fetch from Sanity
if (fetchFromSanity) {
  try {
    const query = `*[_type == "homePage"][0]{
      whyChooseUs {
        subtitle,
        title,
        description,
        image {
          asset->{
            _id,
            url
          }
        },
        logoImage {
          asset->{
            _id,
            url
          }
        },
        circleImage {
          asset->{
            _id,
            url
          }
        },
        features[] {
          title,
          description,
          iconBgColor,
          svg
        }
      }
    }`;
    
    const result = await client.fetch(query);
    
    if (result?.whyChooseUs) {
      // Update text fields
      if (result.whyChooseUs.subtitle) subtitle = result.whyChooseUs.subtitle;
      if (result.whyChooseUs.title) title = result.whyChooseUs.title;
      if (result.whyChooseUs.description) description = result.whyChooseUs.description;
      
      // Update images
      if (result.whyChooseUs.image?.asset?.url) {
        image = result.whyChooseUs.image.asset.url;
      }
      if (result.whyChooseUs.logoImage?.asset?.url) {
        logoImage = result.whyChooseUs.logoImage.asset.url;
      }
      if (result.whyChooseUs.circleImage?.asset?.url) {
        circleImage = result.whyChooseUs.circleImage.asset.url;
      }
      
      // Update features
      if (result.whyChooseUs.features?.length > 0) {
        features = result.whyChooseUs.features.map((feature: any) => {
          const color = feature.iconBgColor || '#F05DA8';
          return {
            iconBg: `bg-[${color}]`,
            iconShadow: `shadow-[${color}66_0px_0px_18px_0px]`,
            svg: feature.svg || defaultFeatures[0].svg,
            title: feature.title || 'Feature',
            description: feature.description || '',
          };
        });
      }
    }
  } catch (error) {
    console.error('Error fetching why choose us data:', error);
    // Keep using default data
  }
}
---

<section class="bg-[#f8f6f5] pt-60 md:pt-80 xxl:pt-100 xxl:pb-200 lg:pb-120 md:pb-80 pb-60">
    <div class="container">
        <div class="grid grid-cols-12 gap-30 lg:items-stretch items-center">

            <!-- Left Column - Image (stretches to match the height of the text column) -->
            <div class="lg:col-span-5 col-span-12">
                <div class="relative h-[360px] sm:h-[440px] lg:h-full lg:min-h-[520px]">
                    <figure class="relative h-full rounded-2xl overflow-hidden border border-secondary/10 shadow-[0_30px_70px_-25px_rgba(2,25,53,0.3)]">
                        {image && (
                            <img src={image} alt={title} class="w-full h-full object-cover" loading="lazy" />
                        )}
                        <div class="absolute inset-0 bg-gradient-to-t from-secondary/70 via-secondary/0 to-transparent"></div>
                    </figure>

                    <!-- Open corner mark -->
                    <span class="hidden lg:block absolute -top-12 -right-12 w-44 h-44 border-t-2 border-r-2 border-primary"></span>

                    <!-- Credential card anchored to the base of the image -->
                    <div class="absolute left-20 right-20 bottom-20 flex items-center gap-16 bg-white rounded-xl px-20 py-16 shadow-[0_20px_45px_-18px_rgba(2,25,53,0.35)]">
                        <span class="relative shrink-0 size-52 rounded-full bg-primary flex items-center justify-center overflow-hidden">
                            {circleImage && (
                                <img src={circleImage} alt="" class="absolute inset-0 size-full object-cover opacity-30" loading="lazy" />
                            )}
                            {logoImage && (
                                <img src={logoImage} alt="" class="size-24 relative z-[1]" loading="lazy" />
                            )}
                        </span>
                        <div class="min-w-0">
                            <p class="font-sora font-bold text-secondary text-[15px] leading-tight truncate">{subtitle}</p>
                            <p class="text-gary text-xs leading-snug">{badgeText}</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column - Content -->
            <div class="lg:col-span-7 col-span-12 flex flex-col lg:justify-center">
                <div class="pb-40">
                    <div class="flex items-center gap-10 mb-10">
                        <span class="w-24 h-[2px] bg-primary"></span>
                        <span class="font-montserrat text-[11px] font-bold uppercase tracking-[0.18em] text-primary">{subtitle}</span>
                    </div>
                    <h2 class="xl:text-4.6xl md:text-4xl sm:text-3xl text-2.5xl font-semibold text-secondary font-sora leading-[1.2]">{title}</h2>
                    <p class="text-base leading-28 text-gary font-normal border-l-2 border-primary/60 pl-24 mt-24">{description}</p>
                </div>

                <div class="grid sm:grid-cols-2 grid-cols-1 gap-20">
                    {features.map((feature, index) => (
                        <div class="group flex items-start gap-16 p-20 bg-white rounded-xl border border-secondary/10 hover:border-primary/30 hover:shadow-[0_20px_40px_-24px_rgba(2,25,53,0.25)] duration-500" key={index}>
                            <div class={`${feature.iconBg} size-52 shrink-0 flex items-center justify-center relative ${feature.iconShadow} rounded-full transition-transform duration-500 group-hover:scale-105`} set:html={feature.svg} />
                            <div class="min-w-0">
                                <h4 class="font-bold text-lg pb-4 text-secondary leading-[1.2] font-sora">{feature.title}</h4>
                                <p class="text-sm leading-24 text-gary font-normal">{feature.description}</p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</section>