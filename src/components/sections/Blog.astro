---
// src/components/sections/Blog.astro

import { client } from '../../lib/sanity';

export interface BlogPost {
    id: number;
    title: string;
    excerpt: string;
    image: string;
    date: string;
    month: string;
    author: string;
    comments: number;
    category: string;
    link: string;
    featured?: boolean;
    tags?: string[];
    slug?: string;
}

export interface Props {
    fetchFromSanity?: boolean;
    subtitle?: string;
    title?: string;
    buttonText?: string;
    buttonLink?: string;
    posts?: BlogPost[];
    showViewAll?: boolean;
    postsPerPage?: number;
    showCategories?: boolean;
    showSearch?: boolean;
    defaultCategory?: string;
    backgroundClass?: string;
}

const {
    fetchFromSanity = true,
    subtitle = "# Our Blog",
    title = "Insights for a Healthier",
    buttonText = "View All Blog",
    buttonLink = "/blog",
    showViewAll = true,
    postsPerPage = 3,
    showCategories = false,
    showSearch = false,
    defaultCategory = "All",
    backgroundClass = "lg:pb-120 md:pb-80 pb-60",
    posts: propPosts,
} = Astro.props;

// Helper to truncate excerpt
const truncateExcerpt = (text: string, maxLength: number = 80): string => {
    if (!text) return '';
    if (text.length <= maxLength) return text;
    return text.substring(0, maxLength) + '...';
};

let posts: BlogPost[] = [];
let sectionData = { 
    subtitle, 
    title, 
    buttonText, 
    buttonLink 
};

// Fetch from Sanity - from homePage's blogSection
if (fetchFromSanity && !propPosts) {
    try {
        const query = `*[_type == "homePage"][0]{
            blogSection {
                subtitle,
                title,
                viewAllText,
                viewAllLink
            }
        }`;
        
        const result = await client.fetch(query);
        
        if (result?.blogSection) {
            const blogData = result.blogSection;
            
            // Update section data from Sanity
            sectionData = {
                subtitle: blogData.subtitle || subtitle,
                title: blogData.title || title,
                buttonText: blogData.viewAllText || buttonText,
                buttonLink: blogData.viewAllLink || buttonLink,
            };
        }
        
        // Then, fetch all blog posts from blogPost (latest 3)
        const postsQuery = `*[_type == "blogPost"] | order(publishDate desc)[0...${postsPerPage}]{
            title,
            excerpt,
            slug,
            publishDate,
            author,
            comments,
            featuredImage {
                asset->{
                    _id,
                    url
                }
            },
            tags,
            featured,
            category
        }`;
        
        const postsResult = await client.fetch(postsQuery);
        
        if (postsResult && postsResult.length > 0) {
            const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
            
            posts = postsResult.map((post: any, index: number) => {
                const publishDate = post.publishDate ? new Date(post.publishDate) : new Date();
                const monthName = months[publishDate.getMonth()];
                const day = publishDate.getDate().toString().padStart(2, '0');
                const slug = post.slug?.current || `post-${index + 1}`;
                
                return {
                    id: index + 1,
                    title: post.title || 'Untitled Post',
                    excerpt: truncateExcerpt(post.excerpt, 80),
                    image: post.featuredImage?.asset?.url || '/assets/img/blog-two-1.jpg',
                    date: day,
                    month: monthName.substring(0, 3),
                    author: post.author || 'Admin',
                    comments: post.comments || 0,
                    category: post.category || 'Health & Wellness',
                    link: `/blog/${slug}`,
                    featured: post.featured || false,
                    tags: post.tags || [],
                    slug: slug,
                };
            });
        }
    } catch (error) {
        console.error('Error fetching blog data:', error);
    }
} else if (propPosts) {
    posts = propPosts;
}

// Get unique categories
const categories = ["All", ...new Set(posts.map(post => post.category))];

// Filter posts by category if defaultCategory is not "All"
let filteredPosts = posts;
if (defaultCategory !== "All") {
    filteredPosts = posts.filter(post => post.category === defaultCategory);
}

// Get only the number of posts specified
const displayedPosts = filteredPosts.slice(0, postsPerPage);

const { subtitle: finalSubtitle, title: finalTitle, buttonText: finalButtonText, buttonLink: finalButtonLink } = sectionData;
---

<section class={backgroundClass}>
    <div class="container">
        <!-- Section Header -->
        <div class="text-center m-auto lg:w-[60%] sm:pb-50 pb-30">
            <span class="pb-10 block font-sora font-semibold capitalize xxl:text-xxl xl:text-xl sm:text-lg text-base" style="color: var(--theme-colour);">{finalSubtitle}</span>
            <h2 class="xxl:text-5xl xl:text-4.65xl md:text-3.8xl sm:text-3xl text-2.5xl font-semibold font-sora leading-[1.2]" style="color: var(--common-colour);">{finalTitle}</h2>
        </div>

        <!-- Categories (Optional) -->
        {showCategories && (
            <div class="flex flex-wrap justify-center gap-3 mb-30">
                {categories.map((category) => (
                    <a 
                        href={`?category=${category.toLowerCase()}`} 
                        class={`category-btn px-6 py-2 rounded-full text-sm font-medium transition-all duration-300 ${
                            category === defaultCategory ? 'active' : ''
                        }`}
                        style={category === defaultCategory 
                            ? `background-color: var(--theme-colour); color: var(--color-white);` 
                            : `color: var(--color-gary); background-color: var(--color-offwhite);`
                        }
                    >
                        {category}
                    </a>
                ))}
            </div>
        )}

        <!-- Search (Optional) -->
        {showSearch && (
            <div class="flex justify-center mb-30">
                <input 
                    type="text" 
                    placeholder="Search blog posts..." 
                    class="search-input w-full md:w-1/2 px-6 py-3 rounded-lg border focus:outline-none focus:ring-2"
                    style="border-color: var(--color-lightgary); color: var(--common-colour);"
                />
            </div>
        )}

        <!-- Blog Grid -->
        <div class="grid grid-cols-12 gap-25">
            {displayedPosts.length > 0 ? (
                displayedPosts.map((post) => (
                    <div class="lg:col-span-4 md:col-span-6 col-span-12" key={post.id}>
                        <div class="blog-card border p-20 group" style="border-color: var(--color-lightgary); background: var(--color-white);">
                            <!-- Blog Image -->
                            <figure class="overflow-hidden blog-image-wrapper">
                                <img src={post.image} alt={post.title} class="blog-image w-full" loading="lazy" />
                            </figure>
                            
                            <!-- Blog Meta -->
                            <ul class="blog-meta flex items-center gap-20 pt-13 pb-6 relative">
                                <li class="category-item pl-14 relative" style="color: var(--theme-colour);">{post.category || 'Health & Wellness'}</li>
                                <li class="date-item pl-14 relative">
                                    <a href={post.link} class="date-link" style="color: var(--color-gary);">
                                        {post.month} {post.date}, {new Date().getFullYear()}
                                    </a>
                                </li>
                            </ul>
                            
                            <!-- Blog Title -->
                            <h4>
                                <a href={post.link} class="blog-title font-bold xxl:text-2xl xl:text-xxl text-xl leading-30 capitalize xxl:leading-34 pb-20 block font-sora" style="color: var(--common-colour);">
                                    {post.title}
                                </a>
                            </h4>
                            
                            <!-- Read More Button -->
                            <a href={post.link} class="read-more-btn inline-flex items-center gap-2 px-30 py-12 font-semibold font-sora transition-all duration-400 rounded-full" style="color: var(--common-colour); border: 1px solid var(--color-lightgary); background: transparent;">
                                <span>Read More</span>
                                <i class="fa-solid fa-arrow-right arrow-icon transition-all duration-300"></i>
                            </a>
                        </div>
                    </div>
                ))
            ) : (
                <div class="col-span-12 text-center py-10">
                    <p style="color: var(--color-gary);" class="text-lg">No blog posts available yet. Check back soon!</p>
                </div>
            )}
        </div>

        <!-- View All Button -->
        {showViewAll && displayedPosts.length > 0 && (
            <div class="text-center pt-60">
                <a href={finalButtonLink} class="view-all-btn inline-flex items-center gap-2 px-30 py-12 font-semibold font-sora transition-all duration-400 rounded-full max-xx:px-30" style="color: var(--common-colour); border: 1px solid var(--color-lightgary); background: transparent;">
                    <span>View All</span>
                    <i class="fa-solid fa-arrow-right arrow-icon transition-all duration-300"></i>
                </a>
            </div>
        )}
    </div>
</section>

<style is:global>
/* ===== BLOG CARD ===== */
.blog-card {
    transition: all 0.3s ease;
    border-radius: 12px;
}

.blog-card:hover {
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
}

/* ===== IMAGE HOVER ===== */
.blog-image-wrapper {
    border-radius: 8px;
}

.blog-image {
    transition: all 0.5s ease;
}

.blog-card:hover .blog-image {
    transform: scale(1.1) rotate(3deg);
}

/* ===== BLOG META ===== */
.blog-meta li {
    position: relative;
    font-size: 14px;
}

.blog-meta li.pl-14 {
    padding-left: 14px;
}

.blog-meta li.pl-14::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
}

.blog-meta li:first-child.pl-14::before {
    background: var(--theme-colour);
}

.blog-meta li:not(:first-child).pl-14::before {
    background: var(--color-lightgary);
}

/* ===== DATE LINK HOVER ===== */
.date-link {
    transition: color 0.3s ease;
}

.date-link:hover {
    color: var(--theme-colour) !important;
}

/* ===== BLOG TITLE HOVER ===== */
.blog-title {
    transition: color 0.3s ease;
}

.blog-title:hover {
    color: var(--theme-colour) !important;
}

/* ===== READ MORE BUTTON HOVER ===== */
.read-more-btn {
    transition: all 0.4s ease;
}

.read-more-btn:hover {
    background-color: var(--theme-colour) !important;
    color: var(--color-white) !important;
    border-color: var(--theme-colour) !important;
}

.read-more-btn:hover .arrow-icon {
    transform: translateX(5px);
}

/* ===== VIEW ALL BUTTON HOVER ===== */
.view-all-btn {
    transition: all 0.4s ease;
}

.view-all-btn:hover {
    background-color: var(--theme-colour) !important;
    color: var(--color-white) !important;
    border-color: var(--theme-colour) !important;
}

.view-all-btn:hover .arrow-icon {
    transform: translateX(5px);
}

/* ===== CATEGORY BUTTON HOVER ===== */
.category-btn {
    transition: all 0.3s ease;
    cursor: pointer;
}

.category-btn:not(.active):hover {
    background-color: var(--theme-colour) !important;
    color: var(--color-white) !important;
}

/* ===== SEARCH INPUT FOCUS ===== */
.search-input {
    transition: all 0.3s ease;
}

.search-input:focus {
    border-color: var(--theme-colour) !important;
    box-shadow: 0 0 0 2px rgba(166, 12, 19, 0.2);
    outline: none;
}

/* ===== CONTAINER ===== */
.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 15px;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 1024px) {
    .blog-card {
        padding: 20px;
    }
}

@media (max-width: 768px) {
    .blog-meta {
        gap: 12px;
        flex-wrap: wrap;
    }
    
    .blog-meta li {
        font-size: 13px;
    }
}

@media (max-width: 480px) {
    .blog-card {
        padding: 16px;
    }
    
    .read-more-btn,
    .view-all-btn {
        padding: 10px 20px;
        font-size: 14px;
    }
}
</style>