---
// src/components/sections/services/ServicesList.astro

import { client } from '../../../lib/sanity';

export interface Props {
  fetchFromSanity?: boolean;
  subtitle?: string;
  title?: string;
  showPagination?: boolean;
}

const {
  fetchFromSanity = true,
  subtitle = "# Our Services",
  title = "Our Medical Services.",
  showPagination = true,
} = Astro.props;

// Helper function to truncate description
const truncateDescription = (text: string, maxLength: number = 60): string => {
  if (!text) return '';
  if (text.length <= maxLength) return text;
  return text.substring(0, maxLength) + '...';
};

let services: any[] = [];
let sectionData = { subtitle, title };

// Fetch from Sanity
if (fetchFromSanity) {
  try {
    // Get the section settings from servicesPage
    const settingsQuery = `*[_type == "servicesPage"][0]{
      servicesSection {
        subtitle,
        title
      }
    }`;
    
    const settingsResult = await client.fetch(settingsQuery);
    
    if (settingsResult?.servicesSection) {
      sectionData = {
        subtitle: settingsResult.servicesSection.subtitle || subtitle,
        title: settingsResult.servicesSection.title || title,
      };
    }
    
    // Get ALL services from servicesDetails
    const servicesQuery = `*[_type == "servicesDetails"]{
      title,
      description,
      icon,
      slug,
      iconBgColor
    } | order(title asc)`;
    
    const servicesResult = await client.fetch(servicesQuery);
    
    if (servicesResult && servicesResult.length > 0) {
      services = servicesResult.map((service: any) => ({
        title: service.title || 'Untitled Service',
        description: truncateDescription(service.description, 60),
        icon: service.icon || '',
        link: `/services/${service.slug?.current || 'service'}`,
        iconBgColor: service.iconBgColor || 'rgba(240,93,168,0.4)',
        slug: service.slug?.current || 'service',
      }));
    }
  } catch (error) {
    console.error('Error fetching services data:', error);
  }
}
---

<section class="lg:py-120 md:py-100 sm:py-80 py-60">
  <div class="container">
    <div class="xl:pb-50 lg:pb-40 pb-30 w-[fit-content]"> 
      <span class="capitalize font-semibold xxl:text-xxl xl:text-xl sm:text-lg text-base text-primary font-sora pb-5 block">{sectionData.subtitle}</span>
      <h2 class="xl:text-5xl md:text-4xl sm:text-3xl text-2.5xl font-semibold text-secondary font-sora leading-[1.2]">{sectionData.title}</h2> 
    </div>
    
    {services.length > 0 ? (
      <div class="grid grid-cols-12">
        {services.map((service, index) => (
          <div class="lg:col-span-4 md:col-span-6 col-span-12 group" key={index}>
            <div class="services-section shadow-[0px_0px_15px_0px_rgba(0,0,0,0.07)] relative xxl:p-40 p-30 xxl:m-15 m-10 before:w-full before:h-0 before:bg-primary before:absolute before:bottom-0 before:left-0 group-hover:before:h-full before:duration-500">
              <i class="group-hover:bg-white size-90 flex items-center justify-center mb-25 relative rounded-full" 
                 style={`box-shadow: 0px 0px 24px 0px ${service.iconBgColor || 'rgba(240,93,168,0.4)'};`}>
                {service.icon ? (
                  <span set:html={service.icon} />
                ) : (
                  <svg width="45" height="47" viewBox="0 0 45 47" fill="none" xmlns="http://www.w3.org/2000/svg">
