ound" stroke-linejoin="round"/>
                  </svg>
                )}
              </i>
              <h4 class="xl:text-xl font-sora text-secondary font-medium leading-[1.2]">
                <a href={service.link} class="xxl:text-2xl text-xl font-bold font-sora relative text-secondary group-hover:text-white duration-500">
                  {service.title}
                </a>
              </h4>
              <p class="pt-10 pb-20 relative text-base leading-32 text-[#6f6f6f] font-normal group-hover:text-white duration-500">
                {service.description || 'Click to learn more about this service.'}
              </p>
              <a href={service.link} class="relative font-bold text-secondary font-sora group-hover:text-white duration-500">
                Read More<i class="fa-solid fa-arrow-right ml-12 relative"></i>
              </a>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-20">
        <p class="text-gary text-lg">No services available. Please add services in Sanity.</p>
      </div>
    )}
    
    {showPagination && services.length > 6 && (
      <ul class="flex items-center mt-40 pagination justify-center"> 
        <li class="page-item ml-7">
          <a class="page-link" href="javascript:void(0);" aria-label="Previous">
            <span aria-hidden="true"><i class="fa-solid fa-arrow-left"></i></span>
            <span class="sr-only">Previous</span>
          </a>
        </li>
        <li class="page-item ml-7"><a class="page-link" href="javascript:void(0);">1</a></li>
        <li class="page-item ml-7"><a class="page-link" href="javascript:void(0);">2</a></li>
        <li class="page-item ml-7"><a class="page-link" href="javascript:void(0);">...</a></li>
        <li class="page-item ml-7"><a class="page-link" href="javascript:void(0);">12</a></li>
        <li class="page-item ml-7">
          <a class="page-link" href="javascript:void(0);" aria-label="Next">
            <span aria-hidden="true"><i class="fa-solid fa-arrow-right"></i></span>
            <span class="sr-only ml-7">Next</span>
          </a>
        </li>
      </ul>
    )}
  </div>
</section>