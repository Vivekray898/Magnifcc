---
// src/components/sections/Testimonials.astro
import { getTestimonials } from '../../lib/queries';
import { urlFor } from '../../lib/sanity-image';

export interface Props {
  fetchFromSanity?: boolean;
  testimonials?: any[];
  title?: string;
  subtitle?: string;
}

const { 
  fetchFromSanity = false, 
  testimonials: propTestimonials = [], 
  title: propTitle = "What Our Patients Say?", 
  subtitle: propSubtitle = "# Testimonials" 
} = Astro.props;

let testimonials = propTestimonials;
let title = propTitle;
let subtitle = propSubtitle;

if (fetchFromSanity) {
  try {
    const data = await getTestimonials();
    console.log('Testimonials data from homePage:', data);
    
    if (data && data.testimonialsSection) {
      testimonials = data.testimonialsSection.testimonials || [];
      title = data.testimonialsSection.title || propTitle;
      subtitle = data.testimonialsSection.subtitle || propSubtitle;
    }
  } catch (error) {
    console.error('Error in Testimonials component:', error);
  }
}

console.log('Rendering testimonials:', { 
  count: testimonials.length, 
  title, 
  subtitle 
});

// Helper function to safely get image URL
function getImageUrl(image: any) {
  if (!image) return null;
  try {
    // Check if we have a direct URL
    if (image.asset?.url) return image.asset.url;
    // Use Sanity image builder
    return urlFor(image).url();
  } catch (error) {
    console.error('Error getting image URL:', error);
    return null;
  }
}
---

<section class="lg:py-120 md:py-80 py-60">
  <div class="container mx-auto px-4">
    <div class="text-center lg:mx-auto lg:w-[60%] w-full pb-50">
      <span class="pb-10 block font-sora font-semibold capitalize xxl:text-xxl xl:text-xl sm:text-lg text-base text-primary">
        {subtitle}
      </span>
      <h2 class="xl:text-5xl md:text-4xl sm:text-3xl text-2.5xl font-semibold text-secondary font-sora leading-[1.2]">
        {title}
      </h2>
    </div>

    {testimonials && testimonials.length > 0 ? (
      <div class="swiper review-slider relative">
        <div class="swiper-wrapper">
          {testimonials.map((testimonial, index) => {
            const imageUrl = testimonial.authorImage ? getImageUrl(testimonial.authorImage) : null;
            return (
              <div class="swiper-slide" key={testimonial._key || index}>
                <div class="relative p-4">
                  <!-- Stars -->
                  <ul class="flex text-sm gap-4 mb-10">
                    {[...Array(testimonial.rating || 5)].map((_, i) => (
                      <li key={i}>
                        <i class="fa-solid fa-star text-yellow text-lg"></i>
                      </li>
                    ))}
                  </ul>
                  <p class="md:text-2xl sm:text-xl text-lg font-medium pb-21 text-gary line-clamp-3">
                    {testimonial.content}
                  </p>
                  <div class="flex items-center gap-x-15">
                    {imageUrl && (
                      <img 
                        src={imageUrl} 
                        alt={testimonial.authorName || 'Author'}
                        class="rounded-full w-16 h-16 object-cover"
                        loading="lazy"
                      />
                    )}
                    <div>
                      <h5 class="text-base font-bold pb-4 text-secondary font-sora leading-[1.2]">
                        {testimonial.authorName || 'Anonymous'}
                      </h5>
                      <span class="text-sm text-gray-600">{testimonial.authorRole || ''}</span>
                    </div>
                  </div>
                  <img 
                    src="/assets/img/quotes.png" 
                    alt="quotes" 
                    class="absolute right-[0%] bottom-[3%] bg-transparent mt-50"
                    loading="lazy"
                  />
                </div>
              </div>
            );
          })}
        </div>

        <!-- Navigation Buttons - Centered Vertically -->
        <div class="swiper-navigation-container">
          <div class="swiper-button-prev">
            <i class="fa-solid fa-chevron-left"></i>
          </div>
          <div class="swiper-button-next">
            <i class="fa-solid fa-chevron-right"></i>
          </div>
        </div>
      </div>
    ) : (
      <div class="text-center py-10">
        <p class="text-gray-500">No testimonials available. Please add testimonials in the Home Page document in Sanity.</p>
      </div>
    )}
  </div>
</section>

<style is:global>
  .review-slider {
    position: relative;
  }
  
  .review-slider .swiper-slide {
    padding: 20px 30px;
  }
  
  /* Line clamp for 3 lines */
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  /* Navigation container - centered vertically */
  .swiper-navigation-container {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    display: flex;
    justify-content: space-between;
    padding: 0 20px;
    pointer-events: none;
    z-index: 10;
  }
  
  .review-slider .swiper-button-next,
  .review-slider .swiper-button-prev {
    position: relative !important;
    width: 50px !important;
    height: 50px !important;
    margin: 0 !important;
    background: #F4F4FF !important;
    border-radius: 50% !important;
    color: #021935 !important;
    font-size: 18px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    transition: all 0.3s ease !important;
    inset: auto !important;
    pointer-events: all !important;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
  }
  
  .review-slider .swiper-button-next:hover,
  .review-slider .swiper-button-prev:hover {
    color: #f05da8 !important;
    background: #fff !important;
    transform: scale(1.05);
  }
  
  .review-slider .swiper-button-next::after,
  .review-slider .swiper-button-prev::after {
    display: none !important;
  }
  
  .review-slider .swiper-button-disabled {
    opacity: 0.3 !important;
    cursor: not-allowed !important;
    pointer-events: none !important;
  }
  
  @media (max-width: 1023px) {
    .swiper-navigation-container {
      position: relative;
      top: auto;
      transform: none;
      justify-content: center;
      gap: 20px;
      margin-top: 30px;
      padding: 0;
    }
    
    .review-slider .swiper-button-next,
    .review-slider .swiper-button-prev {
      width: 45px !important;
      height: 45px !important;
      font-size: 16px !important;
      position: relative !important;
      display: flex !important;
    }
  }
</style>