---
// src/components/common/Footer.astro
import { getFooter } from '../../lib/queries';
import { imageUrlFor } from '../../lib/sanity-image';
import FloatingWhatsApp from './FloatingWhatsApp.astro';

export interface Props {
  fetchFromSanity?: boolean;
}

const { fetchFromSanity = true } = Astro.props;

// Default footer data (matching original HTML)
const defaultData = {
  newsletter: {
    title: 'Subscribe To Regular Newsletters.',
    placeholder: 'Enter Your Email',
    buttonText: 'Subscribe',
    formAction: 'assets/script/mailchamp.php',
    enabled: true,
  },
  aboutColumn: {
    logo: null,
    tagline: 'Smart Healthcare Solutions',
    description: 'We are committed to delivering exceptional healthcare with compassion, expertise, and innovation. Our dedicated.',
    socialLinks: [
      { platform: 'Facebook', url: 'https://www.facebook.com/', icon: 'fa-brands fa-facebook-f' },
      { platform: 'Twitter', url: 'https://x.com/', icon: 'fa-brands fa-x-twitter' },
      { platform: 'Instagram', url: 'https://www.instagram.com/', icon: 'fa-brands fa-instagram' },
      { platform: 'YouTube', url: 'https://www.youtube.com/', icon: 'fa-brands fa-youtube' },
    ],
  },
  linkColumn1: {
    title: 'Company',
    links: [
      { label: 'Home', link: '/' },
      { label: 'About Us', link: '/about' },
      { label: 'Services', link: '/services' },
    ],
  },
  linkColumn2: {
    title: 'Services',
    links: [
      { label: 'Public Health Consultancy', link: '/services/public-health' },
      { label: 'Healthcare Management', link: '/services/healthcare-management' },
      { label: 'Medical Equipment', link: '/services/medical-equipment' },
    ],
  },
  contactColumn: {
    title: 'Contact Us',
    addresses: [
      { 
        text: 'Sarada Apartment, Opp. College Para Sishu Uddyan, Ashutosh Mukherjee Road, College Para, Siliguri – 734001' 
      }
    ],
    phones: [
      { number: '+91 70471 45306' },
      { number: '+91 70473 88300' }
    ],
    emails: [
      { address: 'info@magnifichcs.com' },
      { address: 'info@magnifichcs.com' }
    ],
  },
  copyright: {
    text: 'Copyright © 2026 Magnific Healthcare Solutions. All Rights Reserved.',
    links: [
      { label: 'Terms & Conditions', link: 'javascript:void(0);' },
      { label: 'Privacy Policy', link: 'javascript:void(0);' },
    ],
  },
  instagram: {
    title: 'Instagram',
    images: [
      { src: '/assets/img/instagram-1.jpg', link: 'https://www.instagram.com/' },
      { src: '/assets/img/instagram-2.jpg', link: 'https://www.instagram.com/' },
      { src: '/assets/img/instagram-3.jpg', link: 'https://www.instagram.com/' },
    ],
  },
  whatsapp: {
    enabled: true,
    phoneNumber: '+917047145306',
    message: 'Hello! I have a question about your services.',
    position: 'bottom-right',
    size: 'medium',
    showTooltip: true,
    tooltipText: 'Chat with us on WhatsApp',
    bottomOffset: 90,
  },
};

let data = defaultData;
let logoUrl = '/assets/img/magnific_logo.svg';

// Icon mapping for social platforms
const getSocialIcon = (platform: string): string => {
  const iconMap: Record<string, string> = {
    'Facebook': 'fa-brands fa-facebook-f',
    'Twitter': 'fa-brands fa-x-twitter',
    'Instagram': 'fa-brands fa-instagram',
    'YouTube': 'fa-brands fa-youtube',
    'LinkedIn': 'fa-brands fa-linkedin-in',
    'Pinterest': 'fa-brands fa-pinterest-p',
    'TikTok': 'fa-brands fa-tiktok',
    'Snapchat': 'fa-brands fa-snapchat-ghost',
    'WhatsApp': 'fa-brands fa-whatsapp',
    'Telegram': 'fa-brands fa-telegram',
    'Discord': 'fa-brands fa-discord',
    'GitHub': 'fa-brands fa-github',
    'Reddit': 'fa-brands fa-reddit-alien',
    'Tumblr': 'fa-brands fa-tumblr',
    'Vimeo': 'fa-brands fa-vimeo-v',
    'Dribbble': 'fa-brands fa-dribbble',
    'Behance': 'fa-brands fa-behance',
    'Medium': 'fa-brands fa-medium',
    'Flickr': 'fa-brands fa-flickr',
    'Twitch': 'fa-brands fa-twitch',
    'SoundCloud': 'fa-brands fa-soundcloud',
    'Spotify': 'fa-brands fa-spotify',
  };
  return iconMap[platform] || 'fa-solid fa-link';
};

// ===== Social brand class for coloured icons =====
const getSocialBrandClass = (platform: string): string => {
  const map: Record<string, string> = {
    'Facebook': 's-facebook',
    'LinkedIn': 's-linkedin',
    'Twitter': 's-x',
    'Instagram': 's-instagram',
    'YouTube': 's-youtube',
    'WhatsApp': 's-whatsapp',
    'Pinterest': 's-pinterest',
    'TikTok': 's-tiktok',
    'Snapchat': 's-snapchat',
  };
  return map[platform] || 's-default';
};

// ===== HELPERS: Auto-generate links =====
const getPhoneLink = (number: string): string => {
  if (!number) return '#';
  const cleaned = number.replace(/[^0-9+]/g, '');
  return `tel:${cleaned}`;
};

const getEmailLink = (email: string): string => {
  if (!email) return '#';
  return `mailto:${email.trim()}`;
};

const getGoogleMapsLink = (address: string, customLink?: string): string => {
  if (customLink) return customLink;
  if (!address) return '#';
  const encoded = encodeURIComponent(address.trim());
  return `https://maps.google.com/?q=${encoded}`;
};

// ===== MIGRATION: Convert old contact format to new array format =====
const migrateContactData = (contactData: any): any => {
  if (!contactData) return defaultData.contactColumn;
  
  const result = {
    title: contactData.title || 'Contact Us',
    addresses: [],
    phones: [],
    emails: [],
  };

  // Check if we have old format (single address, phone, email)
  if (contactData.address && !contactData.addresses) {
    // Old format: single address object
    result.addresses = [{
      text: contactData.address.text || '',
      mapLink: contactData.address.mapLink || '',
    }];
  } else if (contactData.addresses && Array.isArray(contactData.addresses)) {
    // New format: addresses array - preserve all items without labels
    result.addresses = contactData.addresses.map((addr: any) => ({
      text: addr.text || '',
      mapLink: addr.mapLink || '',
    }));
  }

  if (contactData.phone && !contactData.phones) {
    // Old format: single phone object
    result.phones = [{
      number: contactData.phone.number || '',
    }];
  } else if (contactData.phones && Array.isArray(contactData.phones)) {
    // New format: phones array - preserve all items without labels
    result.phones = contactData.phones.map((phone: any) => ({
      number: phone.number || '',
    }));
  }

  if (contactData.email && !contactData.emails) {
    // Old format: single email object
    result.emails = [{
      address: contactData.email.address || '',
    }];
  } else if (contactData.emails && Array.isArray(contactData.emails)) {
    // New format: emails array - preserve all items without labels
    result.emails = contactData.emails.map((email: any) => ({
      address: email.address || '',
    }));
  }

  // If no data at all, use defaults from defaultData
  if (result.addresses.length === 0 && result.phones.length === 0 && result.emails.length === 0) {
    return defaultData.contactColumn;
  }

  return result;
};

// Fetch from Sanity
if (fetchFromSanity) {
  try {
    const result = await getFooter();
    if (result) {
      data = { ...defaultData, ...result };

      // Process social links with icons
      if (result.aboutColumn?.socialLinks) {
        data.aboutColumn.socialLinks = result.aboutColumn.socialLinks.map((link: any) => ({
          ...link,
          icon: link.icon || getSocialIcon(link.platform),
        }));
      }

      // MIGRATE: Convert old contact format to new array format
      if (result.contactColumn) {
        data.contactColumn = migrateContactData(result.contactColumn);
      }

      // Process contact info - generate links for each item (NO LABELS)
      if (data.contactColumn) {
        // Process multiple phones - remove labels
        if (data.contactColumn.phones && Array.isArray(data.contactColumn.phones)) {
          data.contactColumn.phones = data.contactColumn.phones.map((phone: any) => ({
            number: phone.number || '',
            link: getPhoneLink(phone.number),
          }));
        }

        // Process multiple emails - remove labels
        if (data.contactColumn.emails && Array.isArray(data.contactColumn.emails)) {
          data.contactColumn.emails = data.contactColumn.emails.map((email: any) => ({
            address: email.address || '',
            link: getEmailLink(email.address),
          }));
        }

        // Process multiple addresses - remove labels
        if (data.contactColumn.addresses && Array.isArray(data.contactColumn.addresses)) {
          data.contactColumn.addresses = data.contactColumn.addresses.map((address: any) => ({
            text: address.text || '',
            _generatedMapLink: getGoogleMapsLink(address.text, address.mapLink),
          }));
        }
      }

      // Process logo URL
      if (result.aboutColumn?.logo?.asset?.url) {
        logoUrl = result.aboutColumn.logo.asset.url;
      }
    }
  } catch (error) {
    console.error('Error fetching footer data:', error);
  }
}

const { newsletter, aboutColumn, linkColumn1, linkColumn2, contactColumn, copyright, instagram, whatsapp } = data;
const currentYear = new Date().getFullYear();

// Get first address/phone/email for WhatsApp
const firstPhone = contactColumn?.phones?.[0]?.number || '+917047145306';
const firstEmail = contactColumn?.emails?.[0]?.address || 'info@example.com';
---

{/* Floating WhatsApp Button - Only render if enabled */}
{whatsapp?.enabled !== false && (
  <FloatingWhatsApp
    phoneNumber={whatsapp?.phoneNumber || firstPhone}
    message={whatsapp?.message || 'Hello! I have a question about your services.'}
    position={whatsapp?.position || 'bottom-right'}
    size={whatsapp?.size || 'medium'}
    showTooltip={whatsapp?.showTooltip !== false}
    tooltipText={whatsapp?.tooltipText || 'Chat with us on WhatsApp'}
    bottomOffset={whatsapp?.bottomOffset || 90}
  />
)}

<footer class="ttc-footer">
  <div class="ttc-container">
    <div class="ttc-grid">

      <!-- ===== Brand column ===== -->
      <div class="ttc-col ttc-brand">
        <a href="/" class="ttc-logo"><img src={logoUrl} alt="Logo" /></a>
        {aboutColumn.tagline && <p class="ttc-tagline">{aboutColumn.tagline}</p>}
        <p class="ttc-desc">{aboutColumn.description}</p>

        <ul class="ttc-socials">
          {aboutColumn.socialLinks?.map((social, index) => (
            <li key={index}>
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.platform}
                class={`ttc-social ${getSocialBrandClass(social.platform)}`}
              >
                <i class={social.icon || getSocialIcon(social.platform)}></i>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- ===== Link column 1 ===== -->
      <nav class="ttc-col" aria-label={linkColumn1.title}>
        <h5 class="ttc-heading">{linkColumn1.title}</h5>
        <ul class="ttc-links">
          {linkColumn1.links?.map((link, index) => (
            <li key={index}><a href={link.link}>{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <!-- ===== Link column 2 ===== -->
      <nav class="ttc-col" aria-label={linkColumn2.title}>
        <h5 class="ttc-heading">{linkColumn2.title}</h5>
        <ul class="ttc-links">
          {linkColumn2.links?.map((link, index) => (
            <li key={index}><a href={link.link}>{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <!-- ===== Contact column - NO LABELS ===== -->
      <div class="ttc-col ttc-contact">
        <h5 class="ttc-heading">{contactColumn.title}</h5>
        <ul class="ttc-contact-list">
          {/* Phones - no labels */}
          {contactColumn.phones?.map((phone, index) => (
            <li key={`p-${index}`}>
              <a href={phone.link || `tel:${String(phone.number).replace(/[^0-9+]/g, '')}`}>
                {phone.number}
              </a>
            </li>
          ))}
          {/* Emails - no labels */}
          {contactColumn.emails?.map((email, index) => (
            <li key={`e-${index}`}>
              <a href={email.link || `mailto:${email.address}`}>
                {email.address}
              </a>
            </li>
          ))}
          {/* Addresses - no labels */}
          {contactColumn.addresses?.map((address, index) => (
            <li key={`a-${index}`}>
              <a href={address._generatedMapLink || '#'} target="_blank" rel="noopener noreferrer">
                {address.text}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>
  </div>

  <!-- ===== Full-width copyright bar - WHITE ===== -->
  <div class="ttc-copyright">
    <p>{copyright.text.replace('2024', String(currentYear))}</p>
  </div>
</footer>

<style>
/* ===== Clean light footer (reference-screenshot style) ===== */
footer.ttc-footer {
  background: var(--color-offwhite, #edeae4);
  font-family: 'Urbanist', system-ui, sans-serif;
}

.ttc-container {
  max-width: 1320px;
  margin: 0 auto;
  padding: 76px 24px 68px;
}

/* 4-column grid: brand wider, contact wider */
.ttc-grid {
  display: grid;
  grid-template-columns: 1.4fr 0.85fr 1fr 1.15fr;
  gap: 56px;
  align-items: start;
}

/* Headings — small, bold, dark charcoal */
.ttc-heading {
  color: var(--common-colour, #2e2418);
  font-family: 'Sora', system-ui, sans-serif;
  font-size: 17px;
  font-weight: 700;
  letter-spacing: 0.2px;
  margin-bottom: 24px;
}

/* Brand column */
.ttc-logo img { max-width: 210px; height: auto; display: block; }
.ttc-tagline {
  margin-top: 14px;
  font-size: 16px;
  font-weight: 600;
  color: var(--color-gary, #6f6055);
}
.ttc-desc {
  margin-top: 14px;
  font-size: 15px;
  line-height: 1.8;
  color: var(--color-gary, #6f6055);
  max-width: 320px;
}

/* Social icons — brand-coloured rounded squares */
.ttc-socials { display: flex; gap: 10px; margin-top: 28px; flex-wrap: wrap; }
.ttc-social {
  width: 40px; height: 40px;
  border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 15px;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  text-decoration: none;
}
.ttc-social:hover { transform: translateY(-3px); box-shadow: 0 8px 18px -8px rgba(0,0,0,0.35); }

/* Social brand colors */
.s-facebook  { background: #1877f2; }
.s-linkedin  { background: #0a66c2; }
.s-x         { background: #14171a; }
.s-youtube   { background: #ff0000; }
.s-whatsapp  { background: #25d366; }
.s-pinterest { background: #e60023; }
.s-tiktok    { background: #000000; }
.s-snapchat  { background: #fffc00; color: #000; }
.s-default   { background: #8a7b6e; }
.s-instagram {
  background: radial-gradient(140% 140% at 30% 110%,
    #fdf497 0%, #fd5949 45%, #d6249f 60%, #285aeb 90%);
}

/* Link lists — plain, quiet, generous rhythm (no bullets/chevrons) */
.ttc-links li + li { margin-top: 15px; }
.ttc-links a {
  color: var(--color-gary, #6f6055);
  font-size: 15px;
  text-decoration: none;
  transition: color 0.3s ease;
}
.ttc-links a:hover { color: var(--theme-colour, #a60c13); }

/* Contact list — COMPACT spacing, NO LABELS */
.ttc-contact-list { 
  margin: 0; 
  padding: 0; 
  list-style: none;
}
.ttc-contact-list li { 
  margin-bottom: 10px; 
}
.ttc-contact-list li:last-child { 
  margin-bottom: 0; 
}
.ttc-contact-list a {
  display: block;
  color: var(--color-gary, #6f6055);
  font-size: 15px;
  line-height: 1.5;
  text-decoration: none;
  transition: color 0.3s ease;
  word-break: break-word;
}
.ttc-contact-list a:hover { 
  color: var(--theme-colour, #a60c13); 
}

/* Full-width copyright bar - WHITE BACKGROUND */
.ttc-copyright {
  background: #ffffff;
  padding: 17px 24px;
  text-align: center;
  border-top: 1px solid var(--color-lightgary, #e8e6e1);
}
.ttc-copyright p {
  color: var(--color-gary, #6f6055);
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 0.2px;
  margin: 0;
}

/* Responsive */
@media (max-width: 1100px) {
  .ttc-grid { grid-template-columns: 1fr 1fr; gap: 44px; }
}
@media (max-width: 620px) {
  .ttc-container { padding: 56px 20px 48px; }
  .ttc-grid { grid-template-columns: 1fr; gap: 36px; }
  .ttc-desc { max-width: 100%; }
  .ttc-contact-list li { margin-bottom: 8px; }
}
</style>