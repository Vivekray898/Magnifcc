---
// src/components/common/Header.astro

import { getHeader } from '../../lib/queries';
import { imageUrlFor } from '../../lib/sanity-image';

export interface Props {
  fetchFromSanity?: boolean;
  currentPage?: string; // 'home', 'contact', 'about', 'services', 'blog', 'portfolio', 'appointment', 'other'
}

const { fetchFromSanity = true, currentPage = 'home' } = Astro.props;

// Default header data with absolute paths
const defaultData = {
  logo: null,
  navItems: [
    { label: 'Home', link: '/', hasDropdown: true, dropdownItems: [
      { label: 'Home 1', link: '/' },
      { label: 'Home 2', link: '/' },
      { label: 'Home 3', link: '/' },
    ]},
    { label: 'About', link: '/about', hasDropdown: false, dropdownItems: [] },
    { label: 'Research', link: 'javascript:void(0);', hasDropdown: true, dropdownItems: [
      { label: 'Portfolio', link: '/portfolio' },
      { label: 'Portfolio Details', link: '/portfolio' },
    ]},
    { label: 'Page', link: 'javascript:void(0);', hasDropdown: true, dropdownItems: [
      { label: 'Services', link: '/services' },
      { label: 'Services Details', link: '/services' },
      { label: 'Testimonials', link: '/testimonials' },
      { label: 'Pricing Table', link: '/pricing' },
      { label: 'FAQ', link: '/faq' },
      { label: 'Appointment', link: '/appointment' },
    ]},
    { label: 'Blog', link: 'javascript:void(0);', hasDropdown: true, dropdownItems: [
      { label: 'Our Blog', link: '/blog' },
      { label: 'Blog Details', link: '/blog' },
    ]},
    { label: 'Contact', link: '/contact', hasDropdown: false, dropdownItems: [] },
  ],
  contactLinkSettings: {
    contactPageSlug: 'contact',
    contactSectionId: 'contact',
    pagesWithContactForm: ['home', 'contact'],
  },
  ctaButton: { text: 'Book Appointment', link: '/appointment', show: true },
  searchEnabled: true,
};

let data = defaultData;
let logoSrc = '/assets/img/logo.png';

// Fetch from Sanity
if (fetchFromSanity) {
  try {
    const result = await getHeader();
    if (result) {
      data = { ...defaultData, ...result };
      if (result.logo?.asset?.url) {
        logoSrc = result.logo.asset.url;
      }
    }
  } catch (error) {
    console.error('Error fetching header data:', error);
  }
}

// Get contact settings
const contactSettings = data.contactLinkSettings || defaultData.contactLinkSettings;
const pagesWithForm = contactSettings.pagesWithContactForm || ['home', 'contact'];
const contactPageSlug = contactSettings.contactPageSlug || 'contact';
const contactSectionId = contactSettings.contactSectionId || 'contact';

// Function to check if current page has the contact form
const hasContactForm = (page: string): boolean => {
  if (pagesWithForm.includes('all')) return true;
  return pagesWithForm.includes(page);
};

// Function to determine the contact link
const getContactLink = (page: string): string => {
  const hasForm = hasContactForm(page);
  
  if (hasForm) {
    // If the form is on this page, link to the section with smooth scroll
    return `#${contactSectionId}`;
  } else {
    // If the form is not on this page, link to the contact page with anchor
    return `/${contactPageSlug}#${contactSectionId}`;
  }
};

// Process nav items to update the contact link
const processedNavItems = data.navItems.map((item: any) => {
  if (item.isContact || item.label.toLowerCase() === 'contact') {
    const contactLink = getContactLink(currentPage);
    return {
      ...item,
      link: contactLink
    };
  }
  return item;
});

// Process CTA button
let ctaLink = data.ctaButton?.link || '/appointment';
if (data.ctaButton?.isContact) {
  ctaLink = getContactLink(currentPage);
}

const { searchEnabled } = data;
const ctaButton = {
  ...data.ctaButton,
  link: ctaLink
};
---

<header class="z-99 sticky-header main-bar-wraper navbar-expand-lg duretion-500">
  <div class="main-bar">
    <div class="container">
      <div class="bottom-bar">
        <div class="two-bar">
          <div class="flex items-center justify-between">
            <div class="logo">
              <a href="/">
                <img alt="logo" src={logoSrc}>
              </a>
            </div>
          </div>
        </div>
        <a href="javascript:void(0)" id="mobile-menu" class="menu-start">
          <i class="fa-solid fa-bars"></i>
        </a>
        <nav class="navbar lg:block hidden">
          <ul class="navbar-links">
            {processedNavItems.map((item, index) => (
              <li key={index} class={`navbar-dropdown ${item.hasDropdown ? 'menu-item-children' : ''}`}>
                <a href={item.link}>{item.label}</a>
                {item.hasDropdown && item.dropdownItems?.length > 0 && (
                  <ul class="sub-menu">
                    {item.dropdownItems.map((subItem, subIndex) => (
                      <li key={subIndex}><a href={subItem.link}>{subItem.label}</a></li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>
        <div class="header-menu-right">
          {searchEnabled && (
            <div class="header-search-button search-box-outer">
              <a href="javascript:void(0)" class="search-btn">
                <i>
                  <svg fill="#000000" width="30px" height="30px" viewBox="0 -0.24 28.423 28.423"
                    data-name="02 - Search Button" xmlns="http://www.w3.org/2000/svg">
                    <path id="Path_215" data-name="Path 215"
                      d="M14.953,2.547A12.643,12.643,0,1,0,27.6,15.19,12.649,12.649,0,0,0,14.953,2.547Zm0,2A10.643,10.643,0,1,1,4.31,15.19,10.648,10.648,0,0,1,14.953,4.547Z"
                      transform="translate(-2.31 -2.547)" fill-rule="evenodd" />
                    <path id="Path_216" data-name="Path 216"
                      d="M30.441,28.789l-6.276-6.276a1,1,0,1,0-1.414,1.414L29.027,30.2a1,1,0,1,0,1.414-1.414Z"
                      transform="translate(-2.31 -2.547)" fill-rule="evenodd" />
                  </svg>
                </i>
              </a>
            </div>
          )}
          {ctaButton?.show && (
            <a href={ctaButton.link} class="btn xl:block hidden">
              <span>{ctaButton.text}<i class="fa-solid fa-arrow-right"></i></span>
            </a>
          )}
        </div>
      </div>
    </div>
    <!-- Mobile Nav -->
    <div class="mobile-nav" id="mobile-nav">
      <div class="res-log mb-30">
        <a href="/">
          <img alt="logo" src={logoSrc} class="w-auto">
        </a>
      </div>
      <ul>
        {processedNavItems.map((item, index) => (
          <li key={index} class={item.hasDropdown ? 'menu-item-has-children' : ''}>
            <a href={item.link}>{item.label}</a>
            {item.hasDropdown && item.dropdownItems?.length > 0 && (
              <ul class="sub-menu">
                {item.dropdownItems.map((subItem, subIndex) => (
                  <li key={subIndex}><a href={subItem.link}>{subItem.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <a href="JavaScript:void(0)" id="res-cross"></a>
    </div>
  </div>
</header>

<!-- Add smooth scroll JavaScript -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Handle hash links for smooth scrolling
    const hash = window.location.hash;
    if (hash) {
      const target = document.querySelector(hash);
      if (target) {
        setTimeout(() => {
          const headerHeight = document.querySelector('header')?.offsetHeight || 80;
          const targetPosition = target.getBoundingClientRect().top + window.pageYOffset - headerHeight;
          window.scrollTo({ top: targetPosition, behavior: 'smooth' });
        }, 300);
      }
    }

    // Handle click on contact links
    document.querySelectorAll('a[href^="#contact"]').forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = link.getAttribute('href');
        if (targetId) {
          const target = document.querySelector(targetId);
          if (target) {
            const headerHeight = document.querySelector('header')?.offsetHeight || 80;
            const targetPosition = target.getBoundingClientRect().top + window.pageYOffset - headerHeight;
            window.scrollTo({ top: targetPosition, behavior: 'smooth' });
            
            // Update URL without page reload
            if (history.pushState) {
              history.pushState(null, null, targetId);
            }
          }
        }
      });
    });
  });
</script>