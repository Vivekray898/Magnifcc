---
// src/components/common/FloatingWhatsApp.astro

export interface Props {
  phoneNumber?: string;
  message?: string;
  position?: 'bottom-right' | 'bottom-left' | 'top-right' | 'top-left';
  size?: 'small' | 'medium' | 'large';
  showTooltip?: boolean;
  tooltipText?: string;
  bottomOffset?: number; // Add this new prop
}

const {
  phoneNumber = '+1234567890',
  message = 'Hello! I have a question about your services.',
  position = 'bottom-right',
  size = 'medium',
  showTooltip = true,
  tooltipText = 'Chat with us on WhatsApp',
  bottomOffset = 80, // Default offset to make room for scroll-to-top button
} = Astro.props;

// Build WhatsApp URL
const whatsappUrl = `https://wa.me/${phoneNumber.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(message)}`;
---

<!-- Floating WhatsApp Button -->
<div class={`floating-whatsapp wa-${position} wa-${size}`} style={`bottom: ${bottomOffset}px;`}>
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="whatsapp-button"
    aria-label="Chat on WhatsApp"
  >
    <!-- Pulse ring -->
    <span class="wa-ping" aria-hidden="true"></span>

    <!-- WhatsApp icon -->
    <svg class="wa-icon" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
  </a>

  <!-- Tooltip -->
  {showTooltip && (
    <span class="wa-tooltip" role="tooltip">{tooltipText}</span>
  )}
</div>

<style>
  /* ===== Wrapper: fixed position, above everything ===== */
  .floating-whatsapp {
    position: fixed;
    z-index: 9999;
    animation: wa-float 3.5s ease-in-out infinite;
  }

  .wa-bottom-right { right: 28px; }
  .wa-bottom-left  { left: 28px;  }
  .wa-top-right    { right: 28px; top: 28px; }
  .wa-top-left     { left: 28px;  top: 28px; }

  /* ===== Button: real pixel sizes ===== */
  .whatsapp-button {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #25D366;
    color: #ffffff;
    box-shadow: 0 10px 25px -6px rgba(37, 211, 102, 0.55);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .whatsapp-button:hover {
    transform: scale(1.08);
    box-shadow: 0 14px 32px -6px rgba(37, 211, 102, 0.7);
  }

  /* Size variants */
  .wa-small  .whatsapp-button { width: 48px; height: 48px; }
  .wa-medium .whatsapp-button { width: 62px; height: 62px; }
  .wa-large  .whatsapp-button { width: 76px; height: 76px; }

  /* Icon scales with the button */
  .wa-icon {
    position: relative;
    z-index: 2;
    width: 56%;
    height: 56%;
  }

  /* ===== Pulse ring ===== */
  .wa-ping {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #25D366;
    opacity: 0.45;
    z-index: 1;
    animation: wa-ping 2.2s cubic-bezier(0, 0, 0.2, 1) infinite;
    pointer-events: none;
  }

  @keyframes wa-ping {
    75%, 100% {
      transform: scale(1.55);
      opacity: 0;
    }
  }

  /* ===== Tooltip ===== */
  .wa-tooltip {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    right: calc(100% + 14px);
    background: #1a1a1a;
    color: #ffffff;
    font-family: 'Sora', sans-serif;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 14px;
    border-radius: 8px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .floating-whatsapp:hover .wa-tooltip {
    opacity: 1;
  }

  /* Flip tooltip to the right side when button is on the left */
  .wa-bottom-left .wa-tooltip,
  .wa-top-left .wa-tooltip {
    right: auto;
    left: calc(100% + 14px);
  }

  /* ===== Gentle float ===== */
  @keyframes wa-float {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-6px); }
  }

  /* ===== Mobile: tighter to the edge, no tooltip ===== */
  @media (max-width: 640px) {
    .wa-bottom-right { right: 16px; }
    .wa-bottom-left  { left: 16px;  }
    .wa-medium .whatsapp-button { width: 56px; height: 56px; }
    .wa-tooltip { display: none; }
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .floating-whatsapp { animation: none; }
    .wa-ping { animation: none; opacity: 0; }
  }
</style>